# Production apps/web/.env.production.local of the DevTrack beta (docs/deploy/hostinger.md).
# Read by `next build` (the /api/* rewrite target is fixed at build time) and by `next start`.
API_ORIGIN=http://127.0.0.1:4010
# Public address for robots.txt, sitemap.xml and canonical URLs (default is this domain).
SITE_ORIGIN=https://devtrack.nativcode.com.br
