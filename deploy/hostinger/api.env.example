# Production apps/api/.env of the DevTrack beta (docs/deploy/hostinger.md). Copy to apps/api/.env on the
# VPS and fill in the <…> values. Every other variable keeps the default of apps/api/.env.example.
NODE_ENV=production
HOST=127.0.0.1
PORT=4010
LOG_LEVEL=info

# The PostgreSQL 17 container (deploy/hostinger/docker-compose.db.yml); the password is the one of db.env.
DATABASE_URL=postgresql://devtrack:<POSTGRES_PASSWORD>@127.0.0.1:5433/devtrack

# openssl rand -base64 48
APP_HMAC_SECRET=<gerar>

WEB_ORIGIN=https://devtrack.nativcode.com.br
ALLOWED_ORIGINS=https://devtrack.nativcode.com.br

# nginx sets X-Forwarded-For to the client's address and the Next.js rewrite passes it on unchanged.
TRUST_PROXY_HOPS=1

# E-mail (docs/deploy/email.md): Resend over SMTP with TLS, notices by the signed webhook
# https://devtrack.nativcode.com.br/api/mail/notices/resend
SMTP_URL=smtps://resend:<chave da API do Resend>@smtp.resend.com:465
MAIL_FROM="DevTrack <nao-responda@mail.nativcode.com.br>"
MAIL_NOTICE_PROVIDER=resend
MAIL_NOTICE_SECRET=<whsec_… do webhook>

# Code Runner off in the beta: the worker needs its own machine (docs/deploy/code-runner.md).
CODE_RUNNER_ENABLED=false

# Optional: without the key the AI actions show as unavailable and the manual flows keep working.
OPENROUTER_API_KEY=
