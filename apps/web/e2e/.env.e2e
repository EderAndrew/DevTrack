# Configuration of the E2E run (specs/002-stack-alignment/contracts/ci-and-e2e.md). Committed on
# purpose: example values only, nothing here is a real secret. global-setup.ts and
# playwright.config.ts pass these variables to the API, the Prisma CLI and admin:bootstrap; being
# already set, they win over apps/api/.env, so the development database is never reached.

NODE_ENV=development
# API on 4100 and web on 3100, so an open `pnpm dev` (4000/3000) keeps running.
PORT=4100
LOG_LEVEL=warn

# Own database in the postgres-test container (tmpfs), recreated on every run. global-setup.ts
# refuses to run unless the database name contains "e2e".
DATABASE_URL=postgresql://devtrack:devtrack@localhost:5433/devtrack_e2e

APP_HMAC_SECRET=ZTJlLWV4YW1wbGUtaG1hYy1zZWNyZXQtbm90LWEtcmVhbC1zZWNyZXQ=

WEB_ORIGIN=http://localhost:3100
ALLOWED_ORIGINS=http://localhost:3100

# Development Mailpit: SMTP for the API, HTTP API for the journeys (MAILPIT_URL is E2E-only).
SMTP_URL=smtp://localhost:1025
MAIL_FROM="DevTrack <no-reply@devtrack.e2e>"
MAILPIT_URL=http://localhost:8025

# The web's Next.js rewrite adds one X-Forwarded-For hop, as in development.
TRUST_PROXY_HOPS=1

# Rate limits stay at the production defaults; every journey uses its own e-mails (research S14).
MAINTENANCE_INTERVAL_SECONDS=0

# Class invitation delivery retries run every 5 s, so a journey sees a retried e-mail quickly.
MAIL_RETRY_INTERVAL_SECONDS=5

# Syllabus processing runs every second, so a journey sees an uploaded syllabus processed quickly.
SYLLABUS_PROCESSING_INTERVAL_SECONDS=1
