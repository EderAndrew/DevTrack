{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "pnpm build && (swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\" -q -w & node --env-file-if-exists=.env --watch-path=dist dist/main.js)",
    "build": "swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\" --delete-dir-on-start -q",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint --max-warnings 0 .",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:security": "vitest run test/security",
    "admin:bootstrap": "node --env-file-if-exists=.env dist/cli/admin-bootstrap.js",
    "maintenance:run": "node --env-file-if-exists=.env dist/cli/maintenance.js",
    "fixtures:syllabus": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/fixtures/syllabus/build-fixtures.ts",
    "eval:curriculum": "vitest run --config vitest.eval.config.ts test/eval/curriculum-agent.eval.ts",
    "eval:exercises": "vitest run --config vitest.eval.config.ts test/eval/exercise-generator.eval.ts",
    "eval:works": "vitest run --config vitest.eval.config.ts test/eval/work-generator.eval.ts",
    "eval:help": "vitest run --config vitest.eval.config.ts test/eval/work-help.eval.ts",
    "fixtures:curriculum": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/fixtures/curriculum-agent/build-golden.ts",
    "prisma": "prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "nestjs-pino": "^5.2.0",
    "nodemailer": "^10.0.10",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "chokidar": "^5.0.0",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "typescript": "7.0.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
