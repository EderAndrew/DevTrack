// Data model of spec 001 — Foundation, Identity & Access (see specs/001-foundation-identity-access/data-model.md)
// and spec 003 — classes, class invitations and enrollments (specs/003-class-invitations-enrollment/data-model.md).
// Rules Prisma cannot express (partial unique indexes, CHECK, append-only trigger, reference data)
// live as SQL in the migrations. No other academic-domain model belongs here (FR-080, 003/D13).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // `.js` imports: swc keeps import paths as written, and tsconfig's rewriteRelativeImportExtensions
  // would otherwise make the generator write `.ts` ones that the compiled API can't load.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED

  @@map("account_status")
}

enum RoleAssignmentStatus {
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("role_assignment_status")
}

enum GrantSource {
  SELF_SIGNUP
  INVITATION
  ADMIN_BOOTSTRAP
  CLASS_INVITATION

  @@map("grant_source")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("token_purpose")
}

enum BootstrapStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@map("bootstrap_status")
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  USER_REVOKED
  PASSWORD_RESET
  ACCOUNT_CLAIMED
  ACCOUNT_SUSPENDED
  ROLE_DEACTIVATED

  @@map("session_revoke_reason")
}

enum ActorType {
  USER
  OPERATOR
  ANONYMOUS
  SYSTEM

  @@map("actor_type")
}

enum ClassStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("class_status")
}

enum ClassInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED

  @@map("class_invitation_status")
}

enum ClassInvitationCancelReason {
  TEACHER
  CLASS_ARCHIVED
  ALREADY_ENROLLED

  @@map("class_invitation_cancel_reason")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SUPERSEDED

  @@map("delivery_status")
}

enum StudentStatus {
  ACTIVE
  INACTIVE

  @@map("student_status")
}

enum EnrollmentStatus {
  ACTIVE
  REMOVED

  @@map("enrollment_status")
}

enum SubjectStatus {
  ACTIVE
  INACTIVE

  @@map("subject_status")
}

enum SyllabusMediaType {
  PDF
  DOCX
  PNG
  JPEG

  @@map("syllabus_media_type")
}

enum SyllabusProcessingStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED

  @@map("syllabus_processing_status")
}

enum SyllabusFailureCategory {
  UNREADABLE
  TIMEOUT
  INTERNAL

  @@map("syllabus_failure_category")
}

enum SyllabusExtractionResult {
  TEXT
  NO_TEXT

  @@map("syllabus_extraction_result")
}

enum SyllabusRevisionStatus {
  DRAFT
  CONFIRMED

  @@map("syllabus_revision_status")
}

enum SyllabusRevisionSource {
  EXTRACTION
  MANUAL
  REVISION
  /// Created by applying a Curriculum Agent proposal (007 FR-031).
  AI_ASSISTED

  @@map("syllabus_revision_source")
}

/// Only PLANNED is used in 004.
enum ClassMeetingStatus {
  PLANNED
  COMPLETED
  CANCELLED

  @@map("class_meeting_status")
}

enum ClassPlanStatus {
  DRAFT
  READY
  ACTIVE
  ARCHIVED

  @@map("class_plan_status")
}

enum TopicStatus {
  DRAFT
  ACTIVE
  /// "Aula concluída" (004/US9): locked except for archive and reopen.
  COMPLETED
  ARCHIVED

  @@map("topic_status")
}

/// GENERATED is reserved for AI topic generation (next phase).
enum TopicOrigin {
  MANUAL
  GENERATED

  @@map("topic_origin")
}

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String        @unique
  name            String
  passwordHash    String        @map("password_hash")
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  status          AccountStatus @default(ACTIVE)
  statusChangedAt DateTime?     @map("status_changed_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles               UserRole[]       @relation("UserRoleUser")
  rolesGranted        UserRole[]       @relation("UserRoleGrantedBy")
  roleStatusChanges   UserRole[]       @relation("UserRoleStatusChangedBy")
  teacherProfile      TeacherProfile?
  studentProfile      StudentProfile?
  sessions            Session[]
  tokens              UserToken[]
  invitationsSent     Invitation[]     @relation("InvitationInvitedBy")
  invitationsAccepted Invitation[]     @relation("InvitationAcceptedBy")
  invitationsRevoked  Invitation[]     @relation("InvitationRevokedBy")
  adminBootstraps     AdminBootstrap[]

  classesTaught             SchoolClass[]
  classInvitationsSent      ClassInvitation[] @relation("ClassInvitationInvitedBy")
  classInvitationsAccepted  ClassInvitation[] @relation("ClassInvitationAcceptedBy")
  classInvitationsCancelled ClassInvitation[] @relation("ClassInvitationCancelledBy")
  enrollmentsRemoved        Enrollment[]      @relation("EnrollmentRemovedBy")

  subjects                   Subject[]
  syllabusUploads            SyllabusDocument[]
  syllabusRevisionsConfirmed SyllabusRevision[]
  topicsCreated              Topic[]            @relation("TopicCreatedBy")
  topicsUpdated              Topic[]            @relation("TopicUpdatedBy")

  aiExecutionsOwned     AiExecution[]    @relation("AiExecutionWorkspace")
  aiExecutionsRequested AiExecution[]    @relation("AiExecutionRequestedBy")
  aiProposalsOwned      AiProposal[]     @relation("AiProposalWorkspace")
  aiProposalsDecided    AiProposal[]     @relation("AiProposalDecidedBy")
  aiTaskOverridesSet    AiTaskOverride[] @relation("AiTaskOverrideSetBy")

  exercisesOwned          Exercise[]                @relation("ExerciseTeacher")
  exercisesReviewed       Exercise[]                @relation("ExerciseReviewedBy")
  exerciseGenerationBatch ExerciseGenerationBatch[] @relation("ExerciseGenerationBatchTeacher")

  worksOwned             Work[]                  @relation("WorkTeacher")
  worksReviewed          Work[]                  @relation("WorkReviewedBy")
  workGenerationRequests WorkGenerationRequest[] @relation("WorkGenerationRequestTeacher")

  classActivitiesOwned    ClassActivity[]           @relation("ClassActivityTeacher")
  classActivitiesReleased ClassActivity[]           @relation("ClassActivityReleasedBy")
  submissionsAccepted     ActivitySubmission[]      @relation("ActivitySubmissionAcceptedBy")
  gradingsDecided         ActivityQuestionGrading[] @relation("ActivityGradingDecidedBy")
  exerciseResultsMarked   ExerciseQuestionResult[]  @relation("ExerciseResultDecidedBy")
  attendancesMarked       ActivityAttendance[]      @relation("ActivityAttendanceMarkedBy")
  pausesStarted           AttemptPause[]            @relation("AttemptPauseStartedBy")
  pausesReleased          AttemptPause[]            @relation("AttemptPauseReleasedBy")

  @@map("users")
}

model Role {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String  @unique
  name       String
  privileged Boolean @default(false)

  permissions RolePermission[]
  assignments UserRole[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]

  aiAgentVersions AiAgentVersion[]
  aiTools         AiTool[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  roleId            String               @map("role_id") @db.Uuid
  status            RoleAssignmentStatus
  grantedById       String?              @map("granted_by_id") @db.Uuid
  grantedVia        GrantSource          @map("granted_via")
  grantedAt         DateTime             @default(now()) @map("granted_at") @db.Timestamptz(6)
  statusChangedAt   DateTime?            @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById String?              @map("status_changed_by_id") @db.Uuid

  user            User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role            Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy       User? @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  statusChangedBy User? @relation("UserRoleStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId, status])
  @@map("user_roles")
}

model TeacherProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("teacher_profiles")
}

model StudentProfile {
  userId      String        @id @map("user_id") @db.Uuid
  displayName String        @map("display_name")
  /// Stored normalized (trim + uppercase, normalizeRa); unique ignoring case (SQL partial index).
  ra          String?
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollments      Enrollment[]
  activityAttempts ActivityAttempt[]
  attendances      ActivityAttendance[]

  @@map("student_profiles")
}

model SchoolClass {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId       String      @map("teacher_id") @db.Uuid
  name            String
  code            String
  academicYear    Int         @map("academic_year")
  period          String?
  description     String?
  status          ClassStatus @default(ACTIVE)
  statusChangedAt DateTime?   @map("status_changed_at") @db.Timestamptz(6)
  /// Name + code, lowercase, without accents (searchKey, D10); written by the application.
  searchKey       String      @map("search_key")
  /// The class is the offering of this subject (004 E2); same teacher, checked by the service.
  subjectId       String?     @map("subject_id") @db.Uuid
  /// Both or neither, endsOn >= startsOn (SQL CHECK).
  startsOn        DateTime?   @map("starts_on") @db.Date
  endsOn          DateTime?   @map("ends_on") @db.Date
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher         User                     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject         Subject?                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  invitations     ClassInvitation[]
  enrollments     Enrollment[]
  meetings        ClassMeeting[]
  plan            ClassPlan?
  activities      ClassActivity[]
  attendances     ActivityAttendance[]
  exerciseResults ExerciseQuestionResult[]

  @@index([teacherId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([teacherId, academicYear])
  @@index([subjectId])
  @@map("classes")
}

model ClassInvitation {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId          String                       @map("class_id") @db.Uuid
  email            String
  tokenHash        String                       @unique @map("token_hash")
  status           ClassInvitationStatus
  expiresAt        DateTime                     @map("expires_at") @db.Timestamptz(6)
  sendCount        Int                          @default(1) @map("send_count")
  lastSentAt       DateTime                     @map("last_sent_at") @db.Timestamptz(6)
  invitedById      String                       @map("invited_by_id") @db.Uuid
  acceptedAt       DateTime?                    @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?                      @map("accepted_by_user_id") @db.Uuid
  cancelledAt      DateTime?                    @map("cancelled_at") @db.Timestamptz(6)
  cancelledById    String?                      @map("cancelled_by_id") @db.Uuid
  cancelReason     ClassInvitationCancelReason? @map("cancel_reason")
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass SchoolClass               @relation(fields: [classId], references: [id], onDelete: Restrict)
  invitedBy   User                      @relation("ClassInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy  User?                     @relation("ClassInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  cancelledBy User?                     @relation("ClassInvitationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  deliveries  ClassInvitationDelivery[]
  enrollments Enrollment[]

  @@index([classId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([email])
  @@map("class_invitations")
}

/// One row per requested send (creation or resend). Never holds the token, the link or the body (D5).
model ClassInvitationDelivery {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId  String         @map("invitation_id") @db.Uuid
  status        DeliveryStatus
  attempts      Int            @default(0)
  nextAttemptAt DateTime?      @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCode String?        @map("last_error_code")
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitation ClassInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([invitationId, createdAt(sort: Desc)])
  @@map("class_invitation_deliveries")
}

model Enrollment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId       String           @map("class_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  status        EnrollmentStatus
  enrolledAt    DateTime         @map("enrolled_at") @db.Timestamptz(6)
  invitationId  String?          @map("invitation_id") @db.Uuid
  removedAt     DateTime?        @map("removed_at") @db.Timestamptz(6)
  removedById   String?          @map("removed_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass SchoolClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  student     StudentProfile   @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  invitation  ClassInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  removedBy   User?            @relation("EnrollmentRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([classId, status])
  @@index([studentUserId, status])
  @@map("enrollments")
}

// ── 004: subjects, syllabus documents and revisions, class calendar and plan ─────────────

model Subject {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId   String        @map("teacher_id") @db.Uuid
  /// Stored trimmed; unique per teacher ignoring case (SQL index on lower(name)).
  name        String
  description String?
  status      SubjectStatus @default(ACTIVE)
  /// Name, lowercase, without accents (003 D10); written by the application.
  searchKey   String        @map("search_key")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher                User                    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classes                SchoolClass[]
  syllabusDocuments      SyllabusDocument[]
  works                  Work[]
  workGenerationRequests WorkGenerationRequest[]
  classActivities        ClassActivity[]

  @@index([teacherId, status, name])
  @@map("subjects")
}

/// Original files, immutable (trigger rejects UPDATE and DELETE). Only PostgresFileStorage touches it (E4).
model StoredFile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bytes     Bytes    @db.ByteA
  /// CHECK size_bytes = octet_length(bytes).
  sizeBytes Int      @map("size_bytes")
  sha256    Bytes    @db.ByteA
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document SyllabusDocument?

  @@map("stored_files")
}

/// One uploaded syllabus version of a subject; also the processing queue (E7).
model SyllabusDocument {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId        String                    @map("subject_id") @db.Uuid
  version          Int
  fileId           String                    @unique @map("file_id") @db.Uuid
  originalFilename String                    @map("original_filename")
  mediaType        SyllabusMediaType         @map("media_type")
  sizeBytes        Int                       @map("size_bytes")
  sha256           Bytes                     @db.ByteA
  pageCount        Int?                      @map("page_count")
  processingStatus SyllabusProcessingStatus  @default(UPLOADED) @map("processing_status")
  attempts         Int                       @default(0)
  nextAttemptAt    DateTime                  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseExpiresAt   DateTime?                 @map("lease_expires_at") @db.Timestamptz(6)
  failureCategory  SyllabusFailureCategory?  @map("failure_category")
  extractionResult SyllabusExtractionResult? @map("extraction_result")
  /// SyllabusExtraction (E10); written once, in the PROCESSING → PROCESSED transition.
  extraction       Json?
  extractorVersion Int?                      @map("extractor_version")
  processedAt      DateTime?                 @map("processed_at") @db.Timestamptz(6)
  uploadedById     String                    @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject    Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  file       StoredFile         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy User               @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  revisions  SyllabusRevision[]

  /// Also serves the subject listing (newest version first) with a backward scan.
  @@unique([subjectId, version])
  /// The same file does not create a new version (FR-011).
  @@unique([subjectId, sha256])
  @@index([processingStatus, nextAttemptAt])
  @@map("syllabus_documents")
}

/// Reviewed content of a document. At most one DRAFT per document; CONFIRMED is immutable (triggers).
model SyllabusRevision {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId        String                 @map("document_id") @db.Uuid
  number            Int
  status            SyllabusRevisionStatus
  source            SyllabusRevisionSource
  /// Required iff source = REVISION (CHECK).
  basedOnRevisionId String?                @map("based_on_revision_id") @db.Uuid
  title             String?
  syllabusText      String?                @map("syllabus_text")
  competencyText    String?                @map("competency_text")
  /// Set together (CHECK).
  confirmedAt       DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  confirmedById     String?                @map("confirmed_by_id") @db.Uuid
  /// Required iff source = AI_ASSISTED (CHECK); one revision per proposal (007 FR-034).
  aiProposalId      String?                @unique @map("ai_proposal_id") @db.Uuid
  /// One language per syllabus (010 research X17); frozen with the revision by the immutability trigger.
  languageId        String?                @map("language_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  document                  SyllabusDocument          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  aiProposal                AiProposal?               @relation(fields: [aiProposalId], references: [id], onDelete: Restrict)
  basedOn                   SyllabusRevision?         @relation("SyllabusRevisionBasedOn", fields: [basedOnRevisionId], references: [id], onDelete: Restrict)
  derived                   SyllabusRevision[]        @relation("SyllabusRevisionBasedOn")
  confirmedBy               User?                     @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  language                  ProgrammingLanguage?      @relation(fields: [languageId], references: [id], onDelete: Restrict)
  groups                    SyllabusGroup[]
  items                     SyllabusItem[]
  plans                     ClassPlan[]
  exerciseGenerationBatches ExerciseGenerationBatch[]
  works                     Work[]
  workGenerationRequests    WorkGenerationRequest[]

  @@unique([documentId, number])
  @@map("syllabus_revisions")
}

model SyllabusGroup {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId String  @map("revision_id") @db.Uuid
  position   Int
  title      String?

  revision SyllabusRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  items    SyllabusItem[]

  @@unique([revisionId, position])
  /// Target of the items' composite FK: an item's group belongs to the item's revision.
  @@unique([id, revisionId])
  @@map("syllabus_groups")
}

model SyllabusItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId   String  @map("revision_id") @db.Uuid
  groupId      String  @map("group_id") @db.Uuid
  position     Int
  text         String
  /// The item of the revision this one was copied from (source REVISION); lets a plan remap links (E16).
  originItemId String? @map("origin_item_id") @db.Uuid

  revision                  SyllabusRevision             @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  group                     SyllabusGroup                @relation(fields: [groupId, revisionId], references: [id, revisionId], onDelete: Restrict)
  originItem                SyllabusItem?                @relation("SyllabusItemOrigin", fields: [originItemId], references: [id], onDelete: Restrict)
  copies                    SyllabusItem[]               @relation("SyllabusItemOrigin")
  topicLinks                TopicSyllabusItem[]
  exercises                 Exercise[]
  exerciseGenerationBatches ExerciseGenerationBatch[]
  workTopics                WorkTopic[]
  workGenerationTopics      WorkGenerationRequestTopic[]
  activityQuestionTopics    ClassActivityQuestionTopic[]

  @@unique([groupId, position])
  /// Target of the exercise batches' composite FK: a batch's topic belongs to the batch's revision (010).
  @@unique([id, revisionId])
  @@index([revisionId])
  @@map("syllabus_items")
}

/// A class date. The meeting number is derived on read (row_number by date, E12).
model ClassMeeting {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String             @map("class_id") @db.Uuid
  meetingDate DateTime           @map("meeting_date") @db.Date
  status      ClassMeetingStatus @default(PLANNED)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  topics      Topic[]

  @@unique([classId, meetingDate])
  @@map("class_meetings")
}

/// One per class, created when the class first selects a confirmed syllabus revision.
model ClassPlan {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId            String          @unique @map("class_id") @db.Uuid
  syllabusRevisionId String          @map("syllabus_revision_id") @db.Uuid
  status             ClassPlanStatus @default(DRAFT)
  /// Optimistic concurrency counter (E13).
  revision           Int             @default(1)
  statusChangedAt    DateTime?       @map("status_changed_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass      SchoolClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  syllabusRevision SyllabusRevision @relation(fields: [syllabusRevisionId], references: [id], onDelete: Restrict)
  topics           Topic[]

  @@index([syllabusRevisionId])
  @@map("class_plans")
}

/// Never deleted. `archivedAt` is set iff status = ARCHIVED (CHECK).
model Topic {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId              String       @map("plan_id") @db.Uuid
  /// Restrict: a meeting with topics cannot be deleted (SC-008).
  meetingId           String?      @map("meeting_id") @db.Uuid
  title               String
  description         String?
  position            Int
  origin              TopicOrigin
  status              TopicStatus
  statusBeforeArchive TopicStatus? @map("status_before_archive")
  /// Date of the meeting when the topic was completed (004/US9); kept once archived.
  completedOn         DateTime?    @map("completed_on") @db.Date
  mergedIntoTopicId   String?      @map("merged_into_topic_id") @db.Uuid
  splitFromTopicId    String?      @map("split_from_topic_id") @db.Uuid
  archivedAt          DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdById         String       @map("created_by_id") @db.Uuid
  updatedById         String       @map("updated_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan       ClassPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  meeting    ClassMeeting?       @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  mergedInto Topic?              @relation("TopicMergedInto", fields: [mergedIntoTopicId], references: [id], onDelete: Restrict)
  mergedFrom Topic[]             @relation("TopicMergedInto")
  splitFrom  Topic?              @relation("TopicSplitFrom", fields: [splitFromTopicId], references: [id], onDelete: Restrict)
  splitInto  Topic[]             @relation("TopicSplitFrom")
  createdBy  User                @relation("TopicCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  User                @relation("TopicUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  items      TopicSyllabusItem[]

  /// DEFERRABLE INITIALLY DEFERRED in SQL, so reordering can swap positions in one transaction.
  @@unique([planId, position])
  @@index([planId, status, position])
  @@index([meetingId])
  @@map("topics")
}

model TopicSyllabusItem {
  topicId   String   @map("topic_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  topic Topic        @relation(fields: [topicId], references: [id], onDelete: Restrict)
  item  SyllabusItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([topicId, itemId])
  @@index([itemId])
  @@map("topic_syllabus_items")
}

model Invitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String
  displayName      String           @map("display_name")
  roleId           String           @map("role_id") @db.Uuid
  invitedById      String           @map("invited_by_id") @db.Uuid
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  sendCount        Int              @default(1) @map("send_count")
  lastSentAt       DateTime         @map("last_sent_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedById      String?          @map("revoked_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy  User  @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  revokedBy  User? @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([invitedById, status])
  @@index([email])
  @@map("invitations")
}

model UserToken {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  purpose       TokenPurpose
  tokenHash     String       @unique @map("token_hash")
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime?    @map("used_at") @db.Timestamptz(6)
  invalidatedAt DateTime?    @map("invalidated_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("user_tokens")
}

model AdminBootstrap {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  targetUserId String?         @map("target_user_id") @db.Uuid
  status       BootstrapStatus
  tokenHash    String?         @unique @map("token_hash")
  expiresAt    DateTime?       @map("expires_at") @db.Timestamptz(6)
  linkPrinted  Boolean         @default(false) @map("link_printed")
  operatorHost String          @map("operator_host")
  operatorUser String          @map("operator_user")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz(6)
  cancelledAt  DateTime?       @map("cancelled_at") @db.Timestamptz(6)

  targetUser User? @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@map("admin_bootstraps")
}

model Session {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  tokenHash         String               @unique @map("token_hash")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime             @map("last_used_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokeReason      SessionRevokeReason? @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model AuditEvent {
  id          BigInt    @id @default(autoincrement())
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  type        String
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  requestId   String?   @map("request_id")
  metadata    Json      @default("{}")

  @@index([type, occurredAt])
  @@index([targetType, targetId])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

model AccessRecord {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id") @db.Uuid
  ip         String   @db.Inet
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@map("access_records")
}

model RateLimitCounter {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// ---------------------------------------------------------------------------------------------
// Spec 006 — AI foundation (specs/006-ai-foundation/data-model.md). Definitions come from code
// and are synced at startup (research A4); used versions are immutable (triggers, A5). CHECKs,
// partial indexes, triggers and the ia.* permissions live in the `ai_foundation` migration.
// ---------------------------------------------------------------------------------------------

enum AiAgentStatus {
  DRAFT
  ACTIVE
  DISABLED
  DEPRECATED

  @@map("ai_agent_status")
}

/// L3_ACTION exists for the future and is refused by CHECK in this feature (006 FR-006).
enum AiRiskLevel {
  L1_READ_ONLY
  L2_PROPOSAL
  L3_ACTION

  @@map("ai_risk_level")
}

enum AiExecutionMode {
  ASYNC

  @@map("ai_execution_mode")
}

enum AiPromptStatus {
  DRAFT
  ACTIVE
  DEPRECATED

  @@map("ai_prompt_status")
}

enum AiModelConfigStatus {
  ENABLED
  DISABLED

  @@map("ai_model_config_status")
}

enum AiToolStatus {
  ENABLED
  DISABLED

  @@map("ai_tool_status")
}

enum AiExecutionStatus {
  QUEUED
  RUNNING
  WAITING_TOOL
  VALIDATING_OUTPUT
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT

  @@map("ai_execution_status")
}

/// Diagnostic step within RUNNING (research A8); the workflow is AiExecutionStatus.
enum AiExecutionStep {
  CONTEXT_RESOLVED
  MODEL_CALL
  TOOL_CALL
  OUTPUT_VALIDATION
  PROPOSAL_CREATED

  @@map("ai_execution_step")
}

/// DENIED only for tool calls.
enum AiCallStatus {
  SUCCEEDED
  DENIED
  FAILED
  TIMED_OUT

  @@map("ai_call_status")
}

enum AiProposalStatus {
  READY_FOR_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  EXPIRED

  @@map("ai_proposal_status")
}

enum AiEvaluationCaseStatus {
  ACTIVE
  RETIRED

  @@map("ai_evaluation_case_status")
}

/// Capability tier of a catalog model, from the cheapest (009 research H3–H5).
enum AiModelTier {
  BASIC
  STANDARD
  ADVANCED

  @@map("ai_model_tier")
}

enum AiModelMode {
  GENERATION
  DECISION

  @@map("ai_model_mode")
}

/// The spec's DISABLED is `ai_model_configs.status` (009 research H4).
enum AiModelLifecycle {
  CANDIDATE
  EVALUATING
  PRODUCTION
  DEPRECATED

  @@map("ai_model_lifecycle")
}

/// Why the policy chose the primary of an execution (009 research H7).
enum AiSelectionReason {
  OVERRIDE
  LOWEST_COST
  ONLY_CANDIDATE
  DEPRECATED_ONLY

  @@map("ai_selection_reason")
}

/// Model configuration; never a credential (FR-018). Status is operational after the first sync.
model AiModelConfig {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String              @unique
  provider           String
  model              String
  status             AiModelConfigStatus
  parameters         Json                @default("{}")
  maxOutputTokens    Int                 @map("max_output_tokens")
  timeoutMs          Int                 @map("timeout_ms")
  inputPricePerMTok  Decimal?            @map("input_price_per_mtok") @db.Decimal(12, 6)
  outputPricePerMTok Decimal?            @map("output_price_per_mtok") @db.Decimal(12, 6)
  currency           String?             @db.Char(3)
  definitionHash     String              @map("definition_hash")
  /// Catalog fields (009 research H2); `tier` NULL only for legacy rows no longer in the catalog.
  family             String?
  tier               AiModelTier?
  mode               AiModelMode         @default(GENERATION)
  lifecycle          AiModelLifecycle    @default(CANDIDATE)
  contextWindow      Int?                @map("context_window")
  /// `{ structuredOutput, tools, vision, reasoning }` booleans.
  capabilities       Json                @default("{}")
  /// Higher first on a cost tie.
  priority           Int                 @default(0)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  agentVersions       AiAgentVersion[]
  executions          AiExecution[]         @relation("AiExecutionPrimary")
  fallbackExecutions  AiExecution[]         @relation("AiExecutionFallback")
  escalatedExecutions AiExecution[]         @relation("AiExecutionEscalation")
  modelCalls          AiModelCall[]
  evaluationResults   AiEvaluationResult[]
  taskApprovals       AiModelTaskApproval[]
  taskOverrides       AiTaskOverride[]

  @@map("ai_model_configs")
}

/// What an agent asks the gateway for, and how it is routed (008 research G2). Synced from code;
/// mutable like model configs, its history is the audit trail. Fallback ≠ primary (CHECK).
model AiTask {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String      @unique
  /// The task's model policy (009 research H5); the route is chosen per request.
  policy          Json
  /// Copy of `policy.preferredTier` for queries.
  preferredTier   AiModelTier @map("preferred_tier")
  parameters      Json        @default("{}")
  maxOutputTokens Int         @map("max_output_tokens")
  timeoutMs       Int         @map("timeout_ms")
  definitionHash  String      @map("definition_hash")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  agentVersions AiAgentVersion[]
  approvals     AiModelTaskApproval[]
  override      AiTaskOverride?

  @@map("ai_tasks")
}

/// Stable identity of an agent; its behavior lives in the versions.
model AiAgent {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String        @unique
  name             String
  description      String
  status           AiAgentStatus
  currentVersionId String?       @map("current_version_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentVersion  AiAgentVersion?         @relation("AiAgentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions        AiAgentVersion[]        @relation("AiAgentVersions")
  prompts         AiPromptVersion[]
  outputSchemas   AiOutputSchemaVersion[]
  evaluationCases AiEvaluationCase[]

  @@map("ai_agents")
}

/// Snapshot of an agent definition; content immutable once `used_at` is set (trigger).
model AiAgentVersion {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId               String          @map("agent_id") @db.Uuid
  version               Int
  riskLevel             AiRiskLevel     @map("risk_level")
  executionMode         AiExecutionMode @default(ASYNC) @map("execution_mode")
  requiredPermission    String          @map("required_permission")
  promptVersionId       String          @map("prompt_version_id") @db.Uuid
  outputSchemaVersionId String?         @map("output_schema_version_id") @db.Uuid
  /// Versions synced before 008 only; exactly one of this and `taskId` (CHECK).
  modelConfigId         String?         @map("model_config_id") @db.Uuid
  taskId                String?         @map("task_id") @db.Uuid
  resourceTypes         String[]        @map("resource_types")
  proposalType          String?         @map("proposal_type")
  limits                Json            @default("{}")
  onToolDenied          String          @default("fail") @map("on_tool_denied")
  definitionHash        String          @map("definition_hash")
  usedAt                DateTime?       @map("used_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  agent             AiAgent                @relation("AiAgentVersions", fields: [agentId], references: [id], onDelete: Restrict)
  permission        Permission             @relation(fields: [requiredPermission], references: [key], onDelete: Restrict)
  promptVersion     AiPromptVersion        @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  outputSchema      AiOutputSchemaVersion? @relation(fields: [outputSchemaVersionId], references: [id], onDelete: Restrict)
  modelConfig       AiModelConfig?         @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)
  task              AiTask?                @relation(fields: [taskId], references: [id], onDelete: Restrict)
  currentOf         AiAgent[]              @relation("AiAgentCurrentVersion")
  tools             AiAgentTool[]
  executions        AiExecution[]
  proposals         AiProposal[]
  evaluationResults AiEvaluationResult[]

  @@unique([agentId, version])
  @@map("ai_agent_versions")
}

/// System instructions from code; never returned by an endpoint nor logged.
model AiPromptVersion {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId            String         @map("agent_id") @db.Uuid
  key                String
  version            Int
  systemInstructions String         @map("system_instructions")
  contentHash        String         @map("content_hash")
  status             AiPromptStatus
  usedAt             DateTime?      @map("used_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  agent             AiAgent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentVersions     AiAgentVersion[]
  executions        AiExecution[]
  evaluationResults AiEvaluationResult[]

  @@unique([agentId, key, version])
  @@map("ai_prompt_versions")
}

model AiOutputSchemaVersion {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId    String    @map("agent_id") @db.Uuid
  version    Int
  jsonSchema Json      @map("json_schema")
  schemaHash String    @map("schema_hash")
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agent         AiAgent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentVersions AiAgentVersion[]
  executions    AiExecution[]
  outputs       AiExecutionOutput[]

  @@unique([agentId, version])
  @@map("ai_output_schema_versions")
}

model AiTool {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String       @unique
  name               String
  description        String
  riskLevel          AiRiskLevel  @map("risk_level")
  timeoutMs          Int          @map("timeout_ms")
  status             AiToolStatus
  requiredPermission String       @map("required_permission")
  resourceType       String?      @map("resource_type")
  inputJsonSchema    Json         @map("input_json_schema")
  outputFields       String[]     @map("output_fields")
  definitionHash     String       @map("definition_hash")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  permission Permission    @relation(fields: [requiredPermission], references: [key], onDelete: Restrict)
  agents     AiAgentTool[]
  calls      AiToolCall[]

  @@map("ai_tools")
}

/// Explicit tool allowlist of an agent version (FR-034); no wildcard.
model AiAgentTool {
  agentVersionId String @map("agent_version_id") @db.Uuid
  toolId         String @map("tool_id") @db.Uuid

  agentVersion AiAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  tool         AiTool         @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@id([agentVersionId, toolId])
  @@map("ai_agent_tools")
}

/// One agent execution; the table is also the worker's queue (research A6).
model AiExecution {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The session teacher (research A2).
  workspaceId             String             @map("workspace_id") @db.Uuid
  requestedByUserId       String             @map("requested_by_user_id") @db.Uuid
  agentVersionId          String             @map("agent_version_id") @db.Uuid
  agentKey                String             @map("agent_key")
  agentVersion            Int                @map("agent_version")
  promptVersionId         String             @map("prompt_version_id") @db.Uuid
  promptVersion           Int                @map("prompt_version")
  outputSchemaVersionId   String?            @map("output_schema_version_id") @db.Uuid
  /// The primary of the route, fixed at request (008 research G5).
  modelConfigId           String             @map("model_config_id") @db.Uuid
  fallbackModelConfigId   String?            @map("fallback_model_config_id") @db.Uuid
  /// NULL for executions requested before 008.
  taskKey                 String?            @map("task_key")
  fallbackUsed            Boolean            @default(false) @map("fallback_used")
  /// Tier and reason of the selection (009 research H7); NULL before 009.
  tier                    AiModelTier?
  selectionReason         AiSelectionReason? @map("selection_reason")
  /// One escalation at most, all fields set together (009 research H9).
  escalationUsed          Boolean            @default(false) @map("escalation_used")
  escalationFromTier      AiModelTier?       @map("escalation_from_tier")
  escalationToTier        AiModelTier?       @map("escalation_to_tier")
  escalationReason        String?            @map("escalation_reason")
  escalationModelConfigId String?            @map("escalation_model_config_id") @db.Uuid
  provider                String
  model                   String
  riskLevel               AiRiskLevel        @map("risk_level")
  resourceType            String?            @map("resource_type")
  resourceId              String?            @map("resource_id") @db.Uuid
  /// Request input; pedagogical, owner-only, never logged.
  input                   Json               @default("{}")
  status                  AiExecutionStatus  @default(QUEUED)
  step                    AiExecutionStep?
  errorCode               String?            @map("error_code")
  modelCalls              Int                @default(0) @map("model_calls")
  toolCalls               Int                @default(0) @map("tool_calls")
  /// Times the worker took the execution; model call retries are in ai_model_calls.attempts.
  claims                  Int                @default(0)
  claimToken              String?            @map("claim_token") @db.Uuid
  leaseExpiresAt          DateTime?          @map("lease_expires_at") @db.Timestamptz(6)
  deadlineAt              DateTime           @map("deadline_at") @db.Timestamptz(6)
  cancelRequestedAt       DateTime?          @map("cancel_requested_at") @db.Timestamptz(6)
  correlationId           String             @map("correlation_id")
  idempotencyKey          String             @map("idempotency_key") @db.Uuid
  requestHash             String             @map("request_hash")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt               DateTime?          @map("started_at") @db.Timestamptz(6)
  finishedAt              DateTime?          @map("finished_at") @db.Timestamptz(6)
  durationMs              Int?               @map("duration_ms")

  workspace               User                     @relation("AiExecutionWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  requestedBy             User                     @relation("AiExecutionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  agentVersionRef         AiAgentVersion           @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  promptVersionRef        AiPromptVersion          @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  outputSchema            AiOutputSchemaVersion?   @relation(fields: [outputSchemaVersionId], references: [id], onDelete: Restrict)
  modelConfig             AiModelConfig            @relation("AiExecutionPrimary", fields: [modelConfigId], references: [id], onDelete: Restrict)
  fallbackModelConfig     AiModelConfig?           @relation("AiExecutionFallback", fields: [fallbackModelConfigId], references: [id], onDelete: Restrict)
  escalationModelConfig   AiModelConfig?           @relation("AiExecutionEscalation", fields: [escalationModelConfigId], references: [id], onDelete: Restrict)
  transitions             AiExecutionTransition[]
  output                  AiExecutionOutput?
  modelCallRows           AiModelCall[]
  toolCallRows            AiToolCall[]
  proposal                AiProposal?
  exerciseGenerationBatch ExerciseGenerationBatch?
  workGenerationRequest   WorkGenerationRequest?
  workHelpRequest         WorkHelpRequest?

  @@unique([requestedByUserId, idempotencyKey])
  @@index([workspaceId, createdAt(sort: Desc), id])
  @@index([agentVersionId, createdAt])
  @@index([createdAt])
  @@map("ai_executions")
}

/// Append-only trail of status changes (US1-2).
model AiExecutionTransition {
  id          BigInt             @id @default(autoincrement())
  executionId String             @map("execution_id") @db.Uuid
  fromStatus  AiExecutionStatus? @map("from_status")
  toStatus    AiExecutionStatus  @map("to_status")
  occurredAt  DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, id])
  @@map("ai_execution_transitions")
}

/// Validated result of an L1 agent; owner-only.
model AiExecutionOutput {
  executionId           String   @id @map("execution_id") @db.Uuid
  outputSchemaVersionId String   @map("output_schema_version_id") @db.Uuid
  output                Json
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  execution    AiExecution           @relation(fields: [executionId], references: [id], onDelete: Cascade)
  outputSchema AiOutputSchemaVersion @relation(fields: [outputSchemaVersionId], references: [id], onDelete: Restrict)

  @@map("ai_execution_outputs")
}

/// One call to the model: the "Uso de IA" of the spec (research A16).
model AiModelCall {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId   String       @map("execution_id") @db.Uuid
  sequence      Int
  modelConfigId String       @map("model_config_id") @db.Uuid
  provider      String
  model         String
  status        AiCallStatus
  attempts      Int
  errorCode     String?      @map("error_code")
  startedAt     DateTime     @map("started_at") @db.Timestamptz(6)
  durationMs    Int          @map("duration_ms")
  inputTokens   Int?         @map("input_tokens")
  outputTokens  Int?         @map("output_tokens")
  totalTokens   Int?         @map("total_tokens")
  estimatedCost Decimal?     @map("estimated_cost") @db.Decimal(14, 6)
  currency      String?      @db.Char(3)
  /// `PROVIDER` (cost the provider reported) or `PRICE` (estimated by the config price); NULL iff no cost (008 research G17).
  costSource    String?      @map("cost_source")
  /// The model the provider says it served; NULL when unknown or on failure (008 research G12).
  servedModel   String?      @map("served_model")
  /// A leg of the route's fallback config (008 research G6).
  isFallback    Boolean      @default(false) @map("is_fallback")
  /// Tier and family of the config the leg called, as they were then (009 research H14).
  tier          AiModelTier?
  family        String?
  /// The leg belongs to the escalated call (009 research H9).
  isEscalation  Boolean      @default(false) @map("is_escalation")

  execution   AiExecution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  modelConfig AiModelConfig @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)

  @@unique([executionId, sequence])
  @@index([startedAt])
  @@map("ai_model_calls")
}

/// One tool call; never its arguments or result (FR-037).
model AiToolCall {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String       @map("execution_id") @db.Uuid
  sequence    Int
  /// The key the model asked for, even if unknown.
  toolKey     String       @map("tool_key")
  toolId      String?      @map("tool_id") @db.Uuid
  status      AiCallStatus
  errorCode   String?      @map("error_code")
  startedAt   DateTime     @map("started_at") @db.Timestamptz(6)
  completedAt DateTime     @map("completed_at") @db.Timestamptz(6)
  durationMs  Int          @map("duration_ms")

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  tool      AiTool?     @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@unique([executionId, sequence])
  @@map("ai_tool_calls")
}

/// Proposal of an L2 agent for the teacher's review; `payload` is immutable (trigger, FR-047).
model AiProposal {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  executionId        String           @unique @map("execution_id") @db.Uuid
  agentVersionId     String           @map("agent_version_id") @db.Uuid
  agentKey           String           @map("agent_key")
  proposalType       String           @map("proposal_type")
  targetResourceType String           @map("target_resource_type")
  targetResourceId   String?          @map("target_resource_id") @db.Uuid
  payload            Json
  itemIds            String[]         @map("item_ids")
  acceptedItemIds    String[]         @default([]) @map("accepted_item_ids")
  status             AiProposalStatus @default(READY_FOR_REVIEW)
  expiresAt          DateTime         @map("expires_at") @db.Timestamptz(6)
  decidedAt          DateTime?        @map("decided_at") @db.Timestamptz(6)
  decidedByUserId    String?          @map("decided_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        User              @relation("AiProposalWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  execution        AiExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  agentVersion     AiAgentVersion    @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  decidedBy        User?             @relation("AiProposalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  /// The draft created by applying this proposal (007); the AI module never writes it.
  syllabusRevision SyllabusRevision?

  @@index([workspaceId, status, createdAt(sort: Desc), id])
  @@map("ai_proposals")
}

model AiEvaluationCase {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId   String                 @map("agent_id") @db.Uuid
  key       String
  version   Int
  /// A fixture path or an id, never content copied from a teacher.
  inputRef  String                 @map("input_ref")
  expected  Json
  status    AiEvaluationCaseStatus
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  agent   AiAgent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  results AiEvaluationResult[]

  @@unique([agentId, key, version])
  @@map("ai_evaluation_cases")
}

model AiEvaluationResult {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  agentVersionId  String   @map("agent_version_id") @db.Uuid
  promptVersionId String   @map("prompt_version_id") @db.Uuid
  modelConfigId   String   @map("model_config_id") @db.Uuid
  provider        String
  model           String
  passed          Boolean
  /// Numbers only.
  metrics         Json     @default("{}")
  ranAt           DateTime @default(now()) @map("ran_at") @db.Timestamptz(6)

  evaluationCase AiEvaluationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  agentVersion   AiAgentVersion   @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  promptVersion  AiPromptVersion  @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  modelConfig    AiModelConfig    @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)

  @@map("ai_evaluation_results")
}

/// A model approved for a task, synced from the catalog (009 research H6); read-only for the app.
model AiModelTaskApproval {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelConfigId String   @map("model_config_id") @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  /// Metric → value, as in the evidence file.
  metrics       Json
  evaluatedAt   DateTime @map("evaluated_at") @db.Timestamptz(6)
  /// Repository path of the evidence file.
  evidence      String
  /// The metrics meet the task's quality thresholds (computed at sync).
  valid         Boolean
  syncedAt      DateTime @map("synced_at") @db.Timestamptz(6)

  modelConfig AiModelConfig @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)
  task        AiTask        @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([modelConfigId, taskId])
  @@map("ai_model_task_approvals")
}

/// The admin's pinned model for a task (009 research H11); one per task.
model AiTaskOverride {
  taskId        String   @id @map("task_id") @db.Uuid
  modelConfigId String   @map("model_config_id") @db.Uuid
  setByUserId   String   @map("set_by_user_id") @db.Uuid
  setAt         DateTime @map("set_at") @db.Timestamptz(6)

  task        AiTask        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  modelConfig AiModelConfig @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)
  setBy       User          @relation("AiTaskOverrideSetBy", fields: [setByUserId], references: [id], onDelete: Restrict)

  @@map("ai_task_overrides")
}

/// One row per budget crossed in a period, so the warning is written once (009 research H16).
model AiBudgetAlert {
  scope       String
  periodStart DateTime @map("period_start") @db.Date
  /// HMAC of the user or agent, never the id in clear; `-` for system scopes.
  subjectHash String   @map("subject_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([scope, periodStart, subjectHash])
  @@map("ai_budget_alerts")
}

// ---------------------------------------------------------------------------------------------
// Spec 010 — exercise bank (specs/010-exercise-bank/data-model.md). The per-type CHECKs, the
// partial unique index of the correct alternative, the deferred trigger of 3–5 alternatives, the
// origin trigger, the language catalog seed and the questoes.* permissions live in the
// `exercise_bank` migration.
// ---------------------------------------------------------------------------------------------

enum ExerciseType {
  OPEN_ANSWER
  MULTIPLE_CHOICE
  CODE

  @@map("exercise_type")
}

/// Pedagogical; unrelated to AiModelTier (010 FR-007).
enum ExerciseDifficulty {
  BASIC
  INTERMEDIATE
  ADVANCED

  @@map("exercise_difficulty")
}

enum CognitiveObjective {
  RECOGNIZE
  UNDERSTAND
  APPLY
  ANALYZE
  CREATE

  @@map("cognitive_objective")
}

enum ExerciseOrigin {
  MANUAL
  AI_GENERATED

  @@map("exercise_origin")
}

enum ExerciseStatus {
  DRAFT
  APPROVED
  ARCHIVED

  @@map("exercise_status")
}

/// Seeded catalog (research X17); no write route. Inactive entries stay valid where used.
model ProgrammingLanguage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  name      String   @unique
  /// Lowercase terms the 007 grounding looks for besides the name.
  aliases   String[] @default([])
  /// Grammar key of the code colors (014 research L3); NULL = plain text. CHECK in the migration.
  highlight String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  syllabusRevisions      SyllabusRevision[]
  exercises              Exercise[]
  generationBatches      ExerciseGenerationBatch[]
  workQuestions          WorkQuestion[]
  workGenerationRequests WorkGenerationRequest[]
  activityQuestions      ClassActivityQuestion[]

  @@map("programming_languages")
}

model Exercise {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The owner; every query filters by it.
  teacherId          String             @map("teacher_id") @db.Uuid
  /// Never changes (trigger).
  type               ExerciseType
  difficulty         ExerciseDifficulty
  cognitiveObjective CognitiveObjective @map("cognitive_objective")
  /// Never changes (trigger, FR-009).
  origin             ExerciseOrigin
  status             ExerciseStatus     @default(DRAFT)
  /// Set iff ARCHIVED (CHECK); the restore target.
  archivedFromStatus ExerciseStatus?    @map("archived_from_status")
  statement          String
  /// `searchKey(statement)`, written by the application (research X20).
  statementSearchKey String             @map("statement_search_key")
  explanation        String
  /// Required iff OPEN_ANSWER (CHECK).
  expectedAnswer     String?            @map("expected_answer")
  /// `instructions`, `expectedSolution` and `languageId` required iff CODE; `starterCode` only CODE (CHECK).
  instructions       String?
  starterCode        String?            @map("starter_code")
  expectedSolution   String?            @map("expected_solution")
  languageId         String?            @map("language_id") @db.Uuid
  /// Only MULTIPLE_CHOICE (CHECK).
  isTrickQuestion    Boolean            @default(false) @map("is_trick_question")
  /// The topic; required when AI_GENERATED (CHECK).
  syllabusItemId     String?            @map("syllabus_item_id") @db.Uuid
  /// Set iff AI_GENERATED, together with the proposal item id (CHECK).
  generationBatchId  String?            @map("generation_batch_id") @db.Uuid
  generationItemId   String?            @map("generation_item_id") @db.Uuid
  humanReviewed      Boolean            @default(false) @map("human_reviewed")
  humanEdited        Boolean            @default(false) @map("human_edited")
  /// Set together (CHECK).
  reviewedById       String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  /// Optimistic concurrency (research X14).
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher           User                     @relation("ExerciseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  language          ProgrammingLanguage?     @relation(fields: [languageId], references: [id], onDelete: Restrict)
  syllabusItem      SyllabusItem?            @relation(fields: [syllabusItemId], references: [id], onDelete: Restrict)
  generationBatch   ExerciseGenerationBatch? @relation(fields: [generationBatchId], references: [id], onDelete: Restrict)
  reviewedBy        User?                    @relation("ExerciseReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  alternatives      ExerciseAlternative[]
  activityQuestions ClassActivityQuestion[]
  activityResults   ExerciseQuestionResult[]

  @@unique([generationBatchId, generationItemId])
  @@index([teacherId, status, updatedAt(sort: Desc), id])
  @@index([teacherId, syllabusItemId])
  @@index([generationBatchId])
  @@map("exercises")
}

/// Only MULTIPLE_CHOICE: 3–5, exactly one correct, distinct texts (deferred trigger); one correct
/// per exercise also by a partial unique index.
model ExerciseAlternative {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId String  @map("exercise_id") @db.Uuid
  /// 0-based presentation order.
  position   Int
  text       String
  isCorrect  Boolean @map("is_correct")

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, position])
  @@map("exercise_alternatives")
}

/// One AI generation request (research X8); its status is derived from the execution and
/// `generatedAt`, never stored (X13).
model ExerciseGenerationBatch {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId              String             @map("teacher_id") @db.Uuid
  /// The topic: an item of the batch's revision (composite FK).
  syllabusItemId         String             @map("syllabus_item_id") @db.Uuid
  syllabusRevisionId     String             @map("syllabus_revision_id") @db.Uuid
  difficulty             ExerciseDifficulty
  /// 3–10, the sum of the counts per type (CHECK).
  requestedQuantity      Int                @map("requested_quantity")
  openAnswerQuantity     Int                @map("open_answer_quantity")
  multipleChoiceQuantity Int                @map("multiple_choice_quantity")
  codeQuantity           Int                @map("code_quantity")
  /// 0–3 and ≤ multiple choice (CHECK).
  trickQuestionQuantity  Int                @map("trick_question_quantity")
  /// Copied from the revision; set iff codeQuantity > 0 (CHECK).
  languageId             String?            @map("language_id") @db.Uuid
  /// AUTO or MANUAL (CHECK).
  distribution           String
  /// Set in the request transaction.
  aiExecutionId          String?            @unique @map("ai_execution_id") @db.Uuid
  regeneratedFromId      String?            @map("regenerated_from_id") @db.Uuid
  idempotencyKey         String             @map("idempotency_key")
  /// Set by the materialization of the proposal (research X8).
  generatedAt            DateTime?          @map("generated_at") @db.Timestamptz(6)
  approvedCount          Int                @default(0) @map("approved_count")
  discardedCount         Int                @default(0) @map("discarded_count")
  archivedCount          Int                @default(0) @map("archived_count")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher          User                      @relation("ExerciseGenerationBatchTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  syllabusItem     SyllabusItem              @relation(fields: [syllabusItemId, syllabusRevisionId], references: [id, revisionId], onDelete: Restrict)
  syllabusRevision SyllabusRevision          @relation(fields: [syllabusRevisionId], references: [id], onDelete: Restrict)
  language         ProgrammingLanguage?      @relation(fields: [languageId], references: [id], onDelete: Restrict)
  aiExecution      AiExecution?              @relation(fields: [aiExecutionId], references: [id], onDelete: Restrict)
  regeneratedFrom  ExerciseGenerationBatch?  @relation("ExerciseGenerationBatchRegeneratedFrom", fields: [regeneratedFromId], references: [id], onDelete: Restrict)
  regenerations    ExerciseGenerationBatch[] @relation("ExerciseGenerationBatchRegeneratedFrom")
  exercises        Exercise[]

  @@unique([teacherId, idempotencyKey])
  @@index([teacherId, createdAt(sort: Desc), id])
  @@map("exercise_generation_batches")
}

// 011 — Work bank (specs/011-work-bank/data-model.md). Apart from the 010 exercise bank: no
// table, enum or relation is shared with it (research W1). CHECKs, deferred triggers and the
// deferrable position constraints are SQL in the migration.

enum WorkQuestionType {
  OPEN_ANSWER
  MULTIPLE_CHOICE
  CODE

  @@map("work_question_type")
}

/// Fixed by the question type (CHECK): MULTIPLE_CHOICE ↔ EXACT_MATCH, CODE ↔ TEST_CASES, OPEN_ANSWER ↔ AI_REVIEW (research W7).
enum WorkGradingStrategy {
  EXACT_MATCH
  TEST_CASES
  AI_REVIEW

  @@map("work_grading_strategy")
}

/// Pedagogical; unrelated to AiModelTier and to ExerciseDifficulty (011 FR-009).
enum WorkDifficulty {
  BASIC
  INTERMEDIATE
  ADVANCED

  @@map("work_difficulty")
}

enum WorkOrigin {
  MANUAL
  AI_GENERATED

  @@map("work_origin")
}

enum WorkStatus {
  DRAFT
  APPROVED
  ARCHIVED

  @@map("work_status")
}

enum WorkTestCaseVisibility {
  PUBLIC
  PRIVATE

  @@map("work_test_case_visibility")
}

model Work {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The owner; every query filters by it.
  teacherId           String          @map("teacher_id") @db.Uuid
  subjectId           String          @map("subject_id") @db.Uuid
  /// The confirmed revision of the work's topics; NULL iff it has no topic; required when AI_GENERATED (CHECK).
  syllabusRevisionId  String?         @map("syllabus_revision_id") @db.Uuid
  title               String
  /// `searchKey(title)`, written by the application (research W19).
  titleSearchKey      String          @map("title_search_key")
  description         String?
  /// Required when AI_GENERATED (CHECK).
  difficulty          WorkDifficulty?
  /// 0.01–100.00 and ≥ 0.01 per question (CHECK); the questions' values add up to it (deferred trigger).
  totalGrade          Decimal         @map("total_grade") @db.Decimal(5, 2)
  /// 1–10, equal to the number of questions (deferred trigger).
  questionCount       Int             @map("question_count")
  /// Never changes (trigger).
  origin              WorkOrigin
  status              WorkStatus      @default(DRAFT)
  /// Set iff ARCHIVED (CHECK); the restore target.
  archivedFromStatus  WorkStatus?     @map("archived_from_status")
  /// Set iff AI_GENERATED (CHECK).
  generationRequestId String?         @unique @map("generation_request_id") @db.Uuid
  humanReviewed       Boolean         @default(false) @map("human_reviewed")
  humanEdited         Boolean         @default(false) @map("human_edited")
  /// Set together (CHECK).
  reviewedById        String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  /// Optimistic concurrency of the whole aggregate (research W16).
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher           User                   @relation("WorkTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  subject           Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  syllabusRevision  SyllabusRevision?      @relation(fields: [syllabusRevisionId], references: [id], onDelete: Restrict)
  generationRequest WorkGenerationRequest? @relation(fields: [generationRequestId], references: [id], onDelete: Restrict)
  reviewedBy        User?                  @relation("WorkReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  topics            WorkTopic[]
  questions         WorkQuestion[]
  classActivities   ClassActivity[]

  /// Target of the topics' composite FK: every topic comes from the work's revision.
  @@unique([id, syllabusRevisionId])
  @@index([teacherId, status, updatedAt(sort: Desc), id])
  @@index([teacherId, subjectId])
  @@index([teacherId, createdAt])
  @@map("works")
}

/// A topic of a work: an item of the work's revision (both composite FKs); ≤ 10 per work (deferred trigger).
model WorkTopic {
  workId             String @map("work_id") @db.Uuid
  syllabusItemId     String @map("syllabus_item_id") @db.Uuid
  syllabusRevisionId String @map("syllabus_revision_id") @db.Uuid
  /// Selection order.
  position           Int

  work           Work                @relation(fields: [workId, syllabusRevisionId], references: [id, syllabusRevisionId], onDelete: Cascade)
  syllabusItem   SyllabusItem        @relation(fields: [syllabusItemId, syllabusRevisionId], references: [id, revisionId], onDelete: Restrict)
  questionTopics WorkQuestionTopic[]

  @@id([workId, syllabusItemId])
  @@unique([workId, position])
  @@index([syllabusItemId])
  @@map("work_topics")
}

model WorkQuestion {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workId             String              @map("work_id") @db.Uuid
  /// 0-based; unique per work, deferrable (reorder).
  position           Int
  /// Never changes (trigger).
  type               WorkQuestionType
  gradingStrategy    WorkGradingStrategy @map("grading_strategy")
  statement          String
  /// `searchKey(statement)`; duplicate detection within a work.
  statementSearchKey String              @map("statement_search_key")
  /// ≥ 0.01; computed by position (research W4), never from a request or the AI.
  value              Decimal             @db.Decimal(5, 2)
  explanation        String?
  /// Required iff OPEN_ANSWER; `rubric` only OPEN_ANSWER (CHECK).
  expectedAnswer     String?             @map("expected_answer")
  rubric             String?
  /// `expectedSolution` and `languageId` required iff CODE; `instructions`, `starterCode` only CODE (CHECK).
  instructions       String?
  starterCode        String?             @map("starter_code")
  expectedSolution   String?             @map("expected_solution")
  languageId         String?             @map("language_id") @db.Uuid
  /// Only MULTIPLE_CHOICE (CHECK).
  isTrickQuestion    Boolean             @default(false) @map("is_trick_question")
  /// The proposal item id of an AI question.
  generationItemId   String?             @map("generation_item_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  work         Work                      @relation(fields: [workId], references: [id], onDelete: Cascade)
  language     ProgrammingLanguage?      @relation(fields: [languageId], references: [id], onDelete: Restrict)
  alternatives WorkQuestionAlternative[]
  testCases    WorkQuestionTestCase[]
  topics       WorkQuestionTopic[]

  /// Target of the question topics' composite FK.
  @@unique([id, workId])
  @@unique([workId, position])
  @@unique([workId, generationItemId])
  @@map("work_questions")
}

/// Only MULTIPLE_CHOICE: 3–5, exactly one correct, distinct texts (deferred trigger); one correct
/// per question also by a partial unique index.
model WorkQuestionAlternative {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  /// 0-based presentation order; deferrable.
  position   Int
  text       String
  isCorrect  Boolean @map("is_correct")

  question WorkQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("work_question_alternatives")
}

/// Only CODE, ≤ 20 per question (deferred trigger). Never executed in 011 (research W20).
model WorkQuestionTestCase {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId     String                 @map("question_id") @db.Uuid
  /// 0-based; deferrable.
  position       Int
  /// 0–10 000 characters, empty allowed.
  input          String
  expectedOutput String                 @map("expected_output")
  /// A PRIVATE case never reaches the student view.
  visibility     WorkTestCaseVisibility

  question WorkQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("work_question_test_cases")
}

/// A question's topics: topics of its own work only (composite FKs); ≤ 3 per question (deferred trigger).
model WorkQuestionTopic {
  questionId     String @map("question_id") @db.Uuid
  workId         String @map("work_id") @db.Uuid
  syllabusItemId String @map("syllabus_item_id") @db.Uuid

  question  WorkQuestion @relation(fields: [questionId, workId], references: [id, workId], onDelete: Cascade)
  workTopic WorkTopic    @relation(fields: [workId, syllabusItemId], references: [workId, syllabusItemId], onDelete: Restrict)

  @@id([questionId, syllabusItemId])
  @@map("work_question_topics")
}

/// One AI generation request (research W10); its status is derived from the execution and
/// `generatedAt`, never stored.
model WorkGenerationRequest {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId              String         @map("teacher_id") @db.Uuid
  subjectId              String         @map("subject_id") @db.Uuid
  /// Confirmed when requested (checked by the service).
  syllabusRevisionId     String         @map("syllabus_revision_id") @db.Uuid
  title                  String
  description            String?
  difficulty             WorkDifficulty
  /// 0.01–100.00 and ≥ 0.01 per question (CHECK).
  totalGrade             Decimal        @map("total_grade") @db.Decimal(5, 2)
  /// 1–10, the sum of the counts per type (CHECK).
  requestedQuantity      Int            @map("requested_quantity")
  openAnswerQuantity     Int            @map("open_answer_quantity")
  multipleChoiceQuantity Int            @map("multiple_choice_quantity")
  codeQuantity           Int            @map("code_quantity")
  /// 0–3 and ≤ multiple choice (CHECK).
  trickQuestionQuantity  Int            @map("trick_question_quantity")
  /// Copied from the revision; set iff codeQuantity > 0 (CHECK).
  languageId             String?        @map("language_id") @db.Uuid
  /// AUTO or MANUAL (CHECK).
  distribution           String
  /// Set in the request transaction.
  aiExecutionId          String?        @unique @map("ai_execution_id") @db.Uuid
  regeneratedFromId      String?        @map("regenerated_from_id") @db.Uuid
  idempotencyKey         String         @map("idempotency_key") @db.Uuid
  /// Set by the materialization of the proposal (research W10).
  generatedAt            DateTime?      @map("generated_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher          User                         @relation("WorkGenerationRequestTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  subject          Subject                      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  syllabusRevision SyllabusRevision             @relation(fields: [syllabusRevisionId], references: [id], onDelete: Restrict)
  language         ProgrammingLanguage?         @relation(fields: [languageId], references: [id], onDelete: Restrict)
  aiExecution      AiExecution?                 @relation(fields: [aiExecutionId], references: [id], onDelete: Restrict)
  regeneratedFrom  WorkGenerationRequest?       @relation("WorkGenerationRequestRegeneratedFrom", fields: [regeneratedFromId], references: [id], onDelete: Restrict)
  regenerations    WorkGenerationRequest[]      @relation("WorkGenerationRequestRegeneratedFrom")
  topics           WorkGenerationRequestTopic[]
  work             Work?

  /// Target of the topics' composite FK: every topic comes from the request's revision.
  @@unique([id, syllabusRevisionId])
  @@unique([teacherId, idempotencyKey])
  @@index([teacherId, createdAt(sort: Desc), id])
  @@map("work_generation_requests")
}

/// 1–10 per request and ≤ 3 × the requested quantity (deferred trigger). The tool's ref is `T{position+1}` (research W12).
model WorkGenerationRequestTopic {
  requestId          String @map("request_id") @db.Uuid
  syllabusItemId     String @map("syllabus_item_id") @db.Uuid
  syllabusRevisionId String @map("syllabus_revision_id") @db.Uuid
  /// 0-based selection order.
  position           Int

  request      WorkGenerationRequest @relation(fields: [requestId, syllabusRevisionId], references: [id, syllabusRevisionId], onDelete: Cascade)
  syllabusItem SyllabusItem          @relation(fields: [syllabusItemId, syllabusRevisionId], references: [id, revisionId], onDelete: Restrict)

  @@id([requestId, syllabusItemId])
  @@unique([requestId, position])
  @@map("work_generation_request_topics")
}

// ── 012: class activities and the student portal (specs/012-student-portal/data-model.md) ──

/// `EXAM` arrives with the exams spec (research P3).
enum ClassActivityType {
  EXERCISE
  ASSIGNMENT

  @@map("class_activity_type")
}

/// `CONTROLLED` only for ASSIGNMENT (CHECK, 015 F2): fullscreen focus page, events recorded.
enum ActivityExecutionMode {
  NORMAL
  CONTROLLED

  @@map("activity_execution_mode")
}

/// Scheduled/published is derived from `publishAt` and the server clock (research P4).
enum ClassActivityStatus {
  ACTIVE
  CLOSED
  CANCELLED

  @@map("class_activity_status")
}

enum ActivityLatePolicy {
  REJECT
  ACCEPT_MARKED

  @@map("activity_late_policy")
}

enum ActivityAttemptStatus {
  IN_PROGRESS
  SUBMITTED

  @@map("activity_attempt_status")
}

enum ActivityQuestionType {
  OPEN_ANSWER
  MULTIPLE_CHOICE
  CODE

  @@map("activity_question_type")
}

enum ActivityGradingStatus {
  GRADED
  PENDING_TEACHER
  DECIDED

  @@map("activity_grading_status")
}

enum ActivityGradingNature {
  RULE_RESULT
  HUMAN_DECISION

  @@map("activity_grading_nature")
}

/// A work or 1–10 exercises of the teacher's banks applied to a class, as a snapshot (research P2).
model ClassActivity {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId              String                @map("class_id") @db.Uuid
  /// The class's teacher when applied; the class, type, grade and source never change (trigger).
  teacherId            String                @map("teacher_id") @db.Uuid
  type                 ClassActivityType
  /// NORMAL unless ASSIGNMENT (CHECK); changes only before the first attempt (trigger, 015 F2).
  executionMode        ActivityExecutionMode @default(NORMAL) @map("execution_mode")
  /// AI helps per student: 0 or 3 (CHECK), 0 unless ASSIGNMENT; changes only before the first attempt (trigger).
  aiHelpAllowance      Int                   @default(0) @map("ai_help_allowance") @db.SmallInt
  /// PRESENT_ONLY only for ASSIGNMENT (CHECK); immutable (trigger). Every work applied since 016 is
  /// PRESENT_ONLY; exercises and older works stay ALL_ENROLLED (016 M2).
  releaseMode          ActivityReleaseMode   @default(ALL_ENROLLED) @map("release_mode")
  status               ClassActivityStatus   @default(ACTIVE)
  /// 1–200 characters (CHECK).
  title                String
  instructions         String?
  /// ASSIGNMENT only (CHECK by type, 013 K1): 0.01–100.00; the questions' values add up to it (deferred trigger).
  totalGrade           Decimal?              @map("total_grade") @db.Decimal(5, 2)
  /// 1–10, equal to the number of questions (deferred trigger).
  questionCount        Int                   @map("question_count")
  publishAt            DateTime              @map("publish_at") @db.Timestamptz(6)
  /// ASSIGNMENT only (CHECK by type, 013 K1); after `publishAt` (CHECK).
  deadline             DateTime?             @db.Timestamptz(6)
  /// ASSIGNMENT only (CHECK by type, 013 K1).
  latePolicy           ActivityLatePolicy?   @map("late_policy")
  /// Set iff ASSIGNMENT (CHECK); informative, the content lives in the snapshot.
  sourceWorkId         String?               @map("source_work_id") @db.Uuid
  /// The work's subject, equal to the class's (research P5).
  sourceSubjectId      String?               @map("source_subject_id") @db.Uuid
  /// Topics outside the taught scope that the teacher acknowledged (FR-005a).
  outOfScopeTopicCount Int                   @default(0) @map("out_of_scope_topic_count")
  /// Set together (CHECK), never for EXERCISE; governs what the students see (research P14).
  resultReleasedAt     DateTime?             @map("result_released_at") @db.Timestamptz(6)
  resultReleasedById   String?               @map("result_released_by_id") @db.Uuid
  closedAt             DateTime?             @map("closed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  idempotencyKey       String                @map("idempotency_key") @db.Uuid
  version              Int                   @default(1)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass      SchoolClass             @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher          User                    @relation("ClassActivityTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  sourceWork       Work?                   @relation(fields: [sourceWorkId], references: [id], onDelete: Restrict)
  sourceSubject    Subject?                @relation(fields: [sourceSubjectId], references: [id], onDelete: Restrict)
  resultReleasedBy User?                   @relation("ClassActivityReleasedBy", fields: [resultReleasedById], references: [id], onDelete: Restrict)
  questions        ClassActivityQuestion[]
  attempts         ActivityAttempt[]
  attendances      ActivityAttendance[]

  @@unique([teacherId, idempotencyKey])
  @@index([classId, status, deadline])
  @@index([classId, publishAt])
  @@map("class_activities")
}

/// A question of the snapshot, with its answer key; immutable (trigger). Only the allowlist reaches students.
model ClassActivityQuestion {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId       String               @map("activity_id") @db.Uuid
  /// 0-based, contiguous (deferred trigger).
  position         Int
  type             ActivityQuestionType
  /// The type's strategy (CHECK, 011 W7).
  gradingStrategy  WorkGradingStrategy  @map("grading_strategy")
  /// ASSIGNMENT only, 0.01–100.00 (CHECK; by type in the deferred trigger, 013 K1).
  value            Decimal?             @db.Decimal(5, 2)
  /// EXERCISE only: the exercise's difficulty and its fixed points (CHECK of the pair, 013 K2).
  difficulty       ExerciseDifficulty?
  points           Int?
  statement        String
  /// `instructions`, `starterCode` only CODE; `expectedSolution`, `languageId` iff CODE (CHECK).
  instructions     String?
  starterCode      String?              @map("starter_code")
  languageId       String?              @map("language_id") @db.Uuid
  /// Iff OPEN_ANSWER; `rubric` only OPEN_ANSWER (CHECK). Teacher only.
  expectedAnswer   String?              @map("expected_answer")
  rubric           String?
  expectedSolution String?              @map("expected_solution")
  explanation      String?
  /// Only MULTIPLE_CHOICE (CHECK). Teacher only.
  isTrickQuestion  Boolean              @default(false) @map("is_trick_question")
  /// The exercise it was copied from, iff EXERCISE (deferred trigger); a work's questions point to the activity's `sourceWorkId`.
  sourceExerciseId String?              @map("source_exercise_id") @db.Uuid

  activity        ClassActivity                @relation(fields: [activityId], references: [id], onDelete: Restrict)
  language        ProgrammingLanguage?         @relation(fields: [languageId], references: [id], onDelete: Restrict)
  sourceExercise  Exercise?                    @relation(fields: [sourceExerciseId], references: [id], onDelete: Restrict)
  alternatives    ClassActivityAlternative[]
  testCases       ClassActivityTestCase[]
  topics          ClassActivityQuestionTopic[]
  answers         ActivityAnswer[]
  gradings        ActivityQuestionGrading[]
  exerciseResults ExerciseQuestionResult[]
  integrityEvents AttemptIntegrityEvent[]
  helpRequests    WorkHelpRequest[]

  @@unique([activityId, position])
  /// Targets of the answers', gradings' and results' composite FKs (research P8, 013 K6).
  @@unique([id, activityId])
  @@unique([id, activityId, type])
  @@unique([id, activityId, points])
  @@map("class_activity_questions")
}

/// 3–5 per MULTIPLE_CHOICE question, exactly one correct (deferred trigger); immutable.
model ClassActivityAlternative {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  /// 0-based presentation order.
  position   Int
  text       String
  /// Teacher only.
  isCorrect  Boolean @map("is_correct")

  question ClassActivityQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers  ActivityAnswer[]

  @@unique([questionId, position])
  /// Target of the answers' composite FK: an answer chooses an alternative of its own question.
  @@unique([questionId, id])
  @@map("class_activity_alternatives")
}

/// Only CODE, at most 20 (deferred trigger); PRIVATE ones never reach the student. Immutable.
model ClassActivityTestCase {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId     String                 @map("question_id") @db.Uuid
  position       Int
  input          String
  expectedOutput String                 @map("expected_output")
  visibility     WorkTestCaseVisibility

  question ClassActivityQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([questionId, position])
  @@map("class_activity_test_cases")
}

/// The syllabus items a question assesses, copied from the bank (constitution XXIII). Immutable.
model ClassActivityQuestionTopic {
  questionId     String @map("question_id") @db.Uuid
  syllabusItemId String @map("syllabus_item_id") @db.Uuid

  question     ClassActivityQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  syllabusItem SyllabusItem          @relation(fields: [syllabusItemId], references: [id], onDelete: Restrict)

  @@id([questionId, syllabusItemId])
  @@index([syllabusItemId])
  @@map("class_activity_question_topics")
}

/// A student's attempt: ASSIGNMENT only number 1; EXERCISE numbered practice attempts, attempt n > 1 only
/// after n − 1 concluded, one IN_PROGRESS at a time (triggers and partial UNIQUE, 013 K3). Never back from SUBMITTED.
model ActivityAttempt {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId            String                @map("activity_id") @db.Uuid
  studentUserId         String                @map("student_user_id") @db.Uuid
  number                Int                   @default(1)
  status                ActivityAttemptStatus @default(IN_PROGRESS)
  startedAt             DateTime              @map("started_at") @db.Timestamptz(6)
  lastSavedAt           DateTime?             @map("last_saved_at") @db.Timestamptz(6)
  /// Throttles `activity_attempt.progress_saved` to one per 15 minutes (research P19).
  lastProgressAuditedAt DateTime?             @map("last_progress_audited_at") @db.Timestamptz(6)
  /// Set iff a concluded EXERCISE attempt (trigger, server clock, 013 K3); ASSIGNMENT keeps its time in the submission.
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  activity        ClassActivity            @relation(fields: [activityId], references: [id], onDelete: Restrict)
  student         StudentProfile           @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  answers         ActivityAnswer[]
  submission      ActivitySubmission?
  results         ExerciseQuestionResult[]
  integrityEvents AttemptIntegrityEvent[]
  helpRequests    WorkHelpRequest[]
  pauses          AttemptPause[]

  @@unique([activityId, studentUserId, number])
  /// Targets of the answers' and the submission's composite FKs.
  @@unique([id, activityId])
  @@unique([id, activityId, studentUserId])
  @@index([studentUserId, activityId])
  @@map("activity_attempts")
}

/// One per question of the attempt, overwritten on each save with a new `revision` (research P8).
/// Its shape follows `questionType` (CHECK); frozen once the attempt is SUBMITTED (trigger).
model ActivityAnswer {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId     String               @map("attempt_id") @db.Uuid
  activityId    String               @map("activity_id") @db.Uuid
  questionId    String               @map("question_id") @db.Uuid
  questionType  ActivityQuestionType @map("question_type")
  /// OPEN_ANSWER, ≤ 20 000 (CHECK).
  text          String?
  /// MULTIPLE_CHOICE; null is a blank choice.
  alternativeId String?              @map("alternative_id") @db.Uuid
  /// CODE, ≤ 100 000 (CHECK); data, never executed (constitution IV).
  source        String?
  revision      Int                  @default(1)
  savedAt       DateTime             @map("saved_at") @db.Timestamptz(6)

  attempt     ActivityAttempt           @relation(fields: [attemptId, activityId], references: [id, activityId], onDelete: Restrict)
  question    ClassActivityQuestion     @relation(fields: [questionId, activityId, questionType], references: [id, activityId, type], onDelete: Restrict)
  alternative ClassActivityAlternative? @relation(fields: [questionId, alternativeId], references: [questionId, id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@map("activity_answers")
}

/// The submitted attempt; the submitted facts never change and it is never deleted (trigger).
model ActivitySubmission {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId       String    @unique @map("attempt_id") @db.Uuid
  activityId      String    @map("activity_id") @db.Uuid
  studentUserId   String    @map("student_user_id") @db.Uuid
  /// Server clock.
  submittedAt     DateTime  @map("submitted_at") @db.Timestamptz(6)
  late            Boolean
  /// Blank questions by spec FR-023.
  blankCount      Int       @map("blank_count")
  /// Set when the teacher accepted the saved attempt (FR-006b); then `late` (CHECK).
  acceptedById    String?   @map("accepted_by_id") @db.Uuid
  /// Sum of the final grades (011 `computeWorkGrade`); partial while a question has none.
  grade           Decimal   @db.Decimal(5, 2)
  gradePartial    Boolean   @map("grade_partial")
  generalFeedback String?   @map("general_feedback")
  gradedAt        DateTime? @map("graded_at") @db.Timestamptz(6)
  /// First student read of a released result (research P19).
  resultViewedAt  DateTime? @map("result_viewed_at") @db.Timestamptz(6)
  /// Optimistic concurrency of the teacher's grading (research P13).
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt    ActivityAttempt           @relation(fields: [attemptId, activityId, studentUserId], references: [id, activityId, studentUserId], onDelete: Restrict)
  acceptedBy User?                     @relation("ActivitySubmissionAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  gradings   ActivityQuestionGrading[]

  /// Target of the gradings' composite FK.
  @@unique([id, activityId])
  /// Required by Prisma for the one-to-one composite relation; `attemptId` alone is already unique.
  @@unique([attemptId, activityId, studentUserId])
  @@index([activityId])
  @@index([studentUserId])
  @@map("activity_submissions")
}

/// One question of a submission graded by a rule or decided by the teacher (011 grading rules).
model ActivityQuestionGrading {
  submissionId  String                 @map("submission_id") @db.Uuid
  questionId    String                 @map("question_id") @db.Uuid
  activityId    String                 @map("activity_id") @db.Uuid
  status        ActivityGradingStatus
  /// GRADED → RULE_RESULT, DECIDED → HUMAN_DECISION, pending → none (CHECK).
  nature        ActivityGradingNature?
  /// 0…the question's value (trigger).
  finalGrade    Decimal?               @map("final_grade") @db.Decimal(5, 2)
  teacherGrade  Decimal?               @map("teacher_grade") @db.Decimal(5, 2)
  /// A `PendingReason` of the contract (CHECK).
  pendingReason String?                @map("pending_reason")
  feedback      String?
  decidedById   String?                @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?              @map("decided_at") @db.Timestamptz(6)

  submission ActivitySubmission    @relation(fields: [submissionId, activityId], references: [id, activityId], onDelete: Restrict)
  question   ClassActivityQuestion @relation(fields: [questionId, activityId], references: [id, activityId], onDelete: Restrict)
  decidedBy  User?                 @relation("ActivityGradingDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@id([submissionId, questionId])
  @@map("activity_question_gradings")
}

/// The result of an exercise in a concluded EXERCISE attempt (013 K6).
enum ExerciseResult {
  CORRECT
  WRONG
  PENDING_TEACHER
  UNSCORED

  @@map("exercise_result")
}

/// One per question of a concluded EXERCISE attempt (013 research K6). The `scoring` row of a bank
/// exercise is unique per student and class (partial UNIQUE, FR-010a); `points` is the question's
/// points only for a CORRECT scoring row (CHECK). Never deleted; only the teacher's mark of a scoring
/// open answer or code row changes (trigger).
model ExerciseQuestionResult {
  attemptId        String                 @map("attempt_id") @db.Uuid
  questionId       String                 @map("question_id") @db.Uuid
  activityId       String                 @map("activity_id") @db.Uuid
  /// The question's points, carried by the composite FK.
  questionPoints   Int                    @map("question_points")
  /// The activity's class (trigger).
  classId          String                 @map("class_id") @db.Uuid
  studentUserId    String                 @map("student_user_id") @db.Uuid
  /// The question's exercise (trigger).
  sourceExerciseId String                 @map("source_exercise_id") @db.Uuid
  /// The row that counts for this exercise in this class: attempt 1 with the slot free.
  scoring          Boolean
  result           ExerciseResult
  points           Int
  /// RULE_RESULT or HUMAN_DECISION; null while pending or unscored (CHECK).
  nature           ActivityGradingNature?
  /// The teacher's, ≤ 2 000 (CHECK).
  comment          String?
  decidedById      String?                @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?              @map("decided_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt        ActivityAttempt       @relation(fields: [attemptId, activityId, studentUserId], references: [id, activityId, studentUserId], onDelete: Restrict)
  question       ClassActivityQuestion @relation(fields: [questionId, activityId, questionPoints], references: [id, activityId, points], onDelete: Restrict)
  schoolClass    SchoolClass           @relation(fields: [classId], references: [id], onDelete: Restrict)
  sourceExercise Exercise              @relation(fields: [sourceExerciseId], references: [id], onDelete: Restrict)
  decidedBy      User?                 @relation("ExerciseResultDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@index([activityId])
  @@map("exercise_question_results")
}

/// 015 research F4: what the controlled mode records. TYPING_LIMIT_EXCEEDED is the server's own (F7).
enum AttemptIntegrityEventType {
  SCREEN_LEFT
  SCREEN_RETURNED
  FULLSCREEN_EXITED
  FULLSCREEN_ENTERED
  PAGE_LEAVE_ATTEMPTED
  CONNECTION_LOST
  CONNECTION_RESTORED
  PASTE_BLOCKED
  COPY_BLOCKED
  CUT_BLOCKED
  DROP_BLOCKED
  TYPING_LIMIT_EXCEEDED
  FULLSCREEN_UNAVAILABLE
  DETECTION_UNAVAILABLE

  @@map("attempt_integrity_event_type")
}

/// 015 research F11: REQUESTED → one terminal status, then immutable (trigger).
enum WorkHelpStatus {
  REQUESTED
  DELIVERED
  OUT_OF_SCOPE
  BLOCKED
  FAILED

  @@map("work_help_status")
}

/// A fact of a CONTROLLED attempt (015 F4), append-only (trigger): written only while the attempt is
/// IN_PROGRESS, never changed or deleted. Exits and durations are derived on read, never stored.
model AttemptIntegrityEvent {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String                    @map("attempt_id") @db.Uuid
  activityId       String                    @map("activity_id") @db.Uuid
  studentUserId    String                    @map("student_user_id") @db.Uuid
  /// The client's id (or the server's, for its own events); a resend is a no-op (UNIQUE).
  clientEventId    String                    @map("client_event_id") @db.Uuid
  type             AttemptIntegrityEventType
  /// Only clipboard and typing events (CHECK); required for TYPING_LIMIT_EXCEEDED.
  questionId       String?                   @map("question_id") @db.Uuid
  /// Server clock.
  recordedAt       DateTime                  @map("recorded_at") @db.Timestamptz(6)
  /// The browser's time, set iff `buffered` (CHECK).
  clientOccurredAt DateTime?                 @map("client_occurred_at") @db.Timestamptz(6)
  buffered         Boolean                   @default(false)

  attempt  ActivityAttempt        @relation(fields: [attemptId, activityId, studentUserId], references: [id, activityId, studentUserId], onDelete: Restrict)
  question ClassActivityQuestion? @relation(fields: [questionId, activityId], references: [id, activityId], onDelete: Restrict)

  @@unique([attemptId, clientEventId])
  @@index([attemptId, recordedAt])
  @@index([activityId])
  @@map("attempt_integrity_events")
}

/// A student's request for AI help on one question of a work (015 F11). One REQUESTED per attempt
/// (partial UNIQUE), at most 3 DELIVERED per attempt and only on an activity whose allowance is 3
/// (deferred trigger); the text fields follow the status (CHECK) and a terminal status is final (trigger).
model WorkHelpRequest {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId      String         @map("attempt_id") @db.Uuid
  activityId     String         @map("activity_id") @db.Uuid
  studentUserId  String         @map("student_user_id") @db.Uuid
  questionId     String         @map("question_id") @db.Uuid
  idempotencyKey String         @map("idempotency_key") @db.Uuid
  /// The student's question, 1–500 characters (CHECK).
  question       String
  status         WorkHelpStatus @default(REQUESTED)
  aiExecutionId  String?        @unique @map("ai_execution_id") @db.Uuid
  /// ≤ 2 000, iff DELIVERED or OUT_OF_SCOPE (CHECK).
  message        String?
  /// ≤ 1 500, only DELIVERED (CHECK).
  exampleCode    String?        @map("example_code")
  /// BLOCKED: the leak-check code; FAILED: the execution's error code; null otherwise (CHECK).
  reasonCode     String?        @map("reason_code")
  requestedAt    DateTime       @map("requested_at") @db.Timestamptz(6)
  /// Set iff not REQUESTED (CHECK).
  resolvedAt     DateTime?      @map("resolved_at") @db.Timestamptz(6)

  attempt     ActivityAttempt       @relation(fields: [attemptId, activityId, studentUserId], references: [id, activityId, studentUserId], onDelete: Restrict)
  questionRef ClassActivityQuestion @relation(fields: [questionId, activityId], references: [id, activityId], onDelete: Restrict)
  aiExecution AiExecution?          @relation(fields: [aiExecutionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, idempotencyKey])
  @@index([attemptId, requestedAt])
  @@map("work_help_requests")
}

// ── 016: attendance-gated release and room exits (specs/016-attendance-gated-release/data-model.md) ──

/// Who sees an activity (016 M2): every ACTIVE enrollment, or only the students marked present.
enum ActivityReleaseMode {
  ALL_ENROLLED
  PRESENT_ONLY

  @@map("activity_release_mode")
}

enum AttemptPauseInitiator {
  STUDENT
  TEACHER

  @@map("attempt_pause_initiator")
}

/// `TEACHER` exactly when the teacher paused the student (CHECK).
enum AttemptPauseReason {
  BATHROOM
  WATER
  PHONE
  OTHER
  TEACHER

  @@map("attempt_pause_reason")
}

/// A student marked present in a PRESENT_ONLY work (016 M3): the work is released to them. Only for an
/// ACTIVE work of an ACTIVE class and a student with an ACTIVE enrollment there (trigger); never
/// updated, and deleted only while the student has no attempt (trigger). The history lives in the audit.
model ActivityAttendance {
  activityId    String   @map("activity_id") @db.Uuid
  studentUserId String   @map("student_user_id") @db.Uuid
  /// The activity's class (trigger).
  classId       String   @map("class_id") @db.Uuid
  /// Server clock; kept on a repeated mark (`ON CONFLICT DO NOTHING`).
  markedAt      DateTime @map("marked_at") @db.Timestamptz(6)
  markedById    String   @map("marked_by_id") @db.Uuid

  activity    ClassActivity  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  student     StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  schoolClass SchoolClass    @relation(fields: [classId], references: [id], onDelete: Restrict)
  markedBy    User           @relation("ActivityAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)

  @@id([activityId, studentUserId])
  @@index([classId])
  @@map("activity_attendances")
}

/// A room exit of an IN_PROGRESS attempt of an ACTIVE PRESENT_ONLY work (016 M6, trigger): declared by
/// the student or opened by the teacher, released only by the teacher, once (trigger). One open pause
/// per attempt (partial UNIQUE). While open and the activity ACTIVE, the attempt's writes are refused
/// (triggers). PAUSED, the end and the duration are derived on read, never stored; never deleted.
model AttemptPause {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId     String                @map("attempt_id") @db.Uuid
  activityId    String                @map("activity_id") @db.Uuid
  studentUserId String                @map("student_user_id") @db.Uuid
  initiatedBy   AttemptPauseInitiator @map("initiated_by")
  reason        AttemptPauseReason
  /// 1–200 characters, only with OTHER (CHECK).
  note          String?
  /// Server clock.
  startedAt     DateTime              @map("started_at") @db.Timestamptz(6)
  startedById   String                @map("started_by_id") @db.Uuid
  /// Server clock; set with `releasedById` (CHECK), once.
  releasedAt    DateTime?             @map("released_at") @db.Timestamptz(6)
  releasedById  String?               @map("released_by_id") @db.Uuid

  attempt    ActivityAttempt @relation(fields: [attemptId, activityId, studentUserId], references: [id, activityId, studentUserId], onDelete: Restrict)
  startedBy  User            @relation("AttemptPauseStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  releasedBy User?           @relation("AttemptPauseReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  @@index([activityId, releasedAt])
  @@map("attempt_pauses")
}
