// Data model of spec 001 — Foundation, Identity & Access (see specs/001-foundation-identity-access/data-model.md)
// and spec 003 — classes, class invitations and enrollments (specs/003-class-invitations-enrollment/data-model.md).
// Rules Prisma cannot express (partial unique indexes, CHECK, append-only trigger, reference data)
// live as SQL in the migrations. No other academic-domain model belongs here (FR-080, 003/D13).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED

  @@map("account_status")
}

enum RoleAssignmentStatus {
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("role_assignment_status")
}

enum GrantSource {
  SELF_SIGNUP
  INVITATION
  ADMIN_BOOTSTRAP
  CLASS_INVITATION

  @@map("grant_source")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("token_purpose")
}

enum BootstrapStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@map("bootstrap_status")
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  USER_REVOKED
  PASSWORD_RESET
  ACCOUNT_CLAIMED
  ACCOUNT_SUSPENDED
  ROLE_DEACTIVATED

  @@map("session_revoke_reason")
}

enum ActorType {
  USER
  OPERATOR
  ANONYMOUS
  SYSTEM

  @@map("actor_type")
}

enum ClassStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("class_status")
}

enum ClassInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED

  @@map("class_invitation_status")
}

enum ClassInvitationCancelReason {
  TEACHER
  CLASS_ARCHIVED
  ALREADY_ENROLLED

  @@map("class_invitation_cancel_reason")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SUPERSEDED

  @@map("delivery_status")
}

enum StudentStatus {
  ACTIVE
  INACTIVE

  @@map("student_status")
}

enum EnrollmentStatus {
  ACTIVE
  REMOVED

  @@map("enrollment_status")
}

enum SubjectStatus {
  ACTIVE
  INACTIVE

  @@map("subject_status")
}

enum SyllabusMediaType {
  PDF
  DOCX
  PNG
  JPEG

  @@map("syllabus_media_type")
}

enum SyllabusProcessingStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED

  @@map("syllabus_processing_status")
}

enum SyllabusFailureCategory {
  UNREADABLE
  TIMEOUT
  INTERNAL

  @@map("syllabus_failure_category")
}

enum SyllabusExtractionResult {
  TEXT
  NO_TEXT

  @@map("syllabus_extraction_result")
}

enum SyllabusRevisionStatus {
  DRAFT
  CONFIRMED

  @@map("syllabus_revision_status")
}

enum SyllabusRevisionSource {
  EXTRACTION
  MANUAL
  REVISION

  @@map("syllabus_revision_source")
}

/// Only PLANNED is used in 004.
enum ClassMeetingStatus {
  PLANNED
  COMPLETED
  CANCELLED

  @@map("class_meeting_status")
}

enum ClassPlanStatus {
  DRAFT
  READY
  ACTIVE
  ARCHIVED

  @@map("class_plan_status")
}

enum TopicStatus {
  DRAFT
  ACTIVE
  /// "Aula concluída" (004/US9): locked except for archive and reopen.
  COMPLETED
  ARCHIVED

  @@map("topic_status")
}

/// GENERATED is reserved for AI topic generation (next phase).
enum TopicOrigin {
  MANUAL
  GENERATED

  @@map("topic_origin")
}

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String        @unique
  name            String
  passwordHash    String        @map("password_hash")
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  status          AccountStatus @default(ACTIVE)
  statusChangedAt DateTime?     @map("status_changed_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles               UserRole[]       @relation("UserRoleUser")
  rolesGranted        UserRole[]       @relation("UserRoleGrantedBy")
  roleStatusChanges   UserRole[]       @relation("UserRoleStatusChangedBy")
  teacherProfile      TeacherProfile?
  studentProfile      StudentProfile?
  sessions            Session[]
  tokens              UserToken[]
  invitationsSent     Invitation[]     @relation("InvitationInvitedBy")
  invitationsAccepted Invitation[]     @relation("InvitationAcceptedBy")
  invitationsRevoked  Invitation[]     @relation("InvitationRevokedBy")
  adminBootstraps     AdminBootstrap[]

  classesTaught             SchoolClass[]
  classInvitationsSent      ClassInvitation[] @relation("ClassInvitationInvitedBy")
  classInvitationsAccepted  ClassInvitation[] @relation("ClassInvitationAcceptedBy")
  classInvitationsCancelled ClassInvitation[] @relation("ClassInvitationCancelledBy")
  enrollmentsRemoved        Enrollment[]      @relation("EnrollmentRemovedBy")

  subjects                   Subject[]
  syllabusUploads            SyllabusDocument[]
  syllabusRevisionsConfirmed SyllabusRevision[]
  topicsCreated              Topic[]            @relation("TopicCreatedBy")
  topicsUpdated              Topic[]            @relation("TopicUpdatedBy")

  aiExecutionsOwned     AiExecution[] @relation("AiExecutionWorkspace")
  aiExecutionsRequested AiExecution[] @relation("AiExecutionRequestedBy")
  aiProposalsOwned      AiProposal[]  @relation("AiProposalWorkspace")
  aiProposalsDecided    AiProposal[]  @relation("AiProposalDecidedBy")

  @@map("users")
}

model Role {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String  @unique
  name       String
  privileged Boolean @default(false)

  permissions RolePermission[]
  assignments UserRole[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]

  aiAgentVersions AiAgentVersion[]
  aiTools         AiTool[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  roleId            String               @map("role_id") @db.Uuid
  status            RoleAssignmentStatus
  grantedById       String?              @map("granted_by_id") @db.Uuid
  grantedVia        GrantSource          @map("granted_via")
  grantedAt         DateTime             @default(now()) @map("granted_at") @db.Timestamptz(6)
  statusChangedAt   DateTime?            @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById String?              @map("status_changed_by_id") @db.Uuid

  user            User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role            Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy       User? @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  statusChangedBy User? @relation("UserRoleStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId, status])
  @@map("user_roles")
}

model TeacherProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("teacher_profiles")
}

model StudentProfile {
  userId      String        @id @map("user_id") @db.Uuid
  displayName String        @map("display_name")
  /// Stored normalized (trim + uppercase, normalizeRa); unique ignoring case (SQL partial index).
  ra          String?
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@map("student_profiles")
}

model SchoolClass {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId       String      @map("teacher_id") @db.Uuid
  name            String
  code            String
  academicYear    Int         @map("academic_year")
  period          String?
  description     String?
  status          ClassStatus @default(ACTIVE)
  statusChangedAt DateTime?   @map("status_changed_at") @db.Timestamptz(6)
  /// Name + code, lowercase, without accents (searchKey, D10); written by the application.
  searchKey       String      @map("search_key")
  /// The class is the offering of this subject (004 E2); same teacher, checked by the service.
  subjectId       String?     @map("subject_id") @db.Uuid
  /// Both or neither, endsOn >= startsOn (SQL CHECK).
  startsOn        DateTime?   @map("starts_on") @db.Date
  endsOn          DateTime?   @map("ends_on") @db.Date
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher     User              @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject     Subject?          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  invitations ClassInvitation[]
  enrollments Enrollment[]
  meetings    ClassMeeting[]
  plan        ClassPlan?

  @@index([teacherId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([teacherId, academicYear])
  @@index([subjectId])
  @@map("classes")
}

model ClassInvitation {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId          String                       @map("class_id") @db.Uuid
  email            String
  tokenHash        String                       @unique @map("token_hash")
  status           ClassInvitationStatus
  expiresAt        DateTime                     @map("expires_at") @db.Timestamptz(6)
  sendCount        Int                          @default(1) @map("send_count")
  lastSentAt       DateTime                     @map("last_sent_at") @db.Timestamptz(6)
  invitedById      String                       @map("invited_by_id") @db.Uuid
  acceptedAt       DateTime?                    @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?                      @map("accepted_by_user_id") @db.Uuid
  cancelledAt      DateTime?                    @map("cancelled_at") @db.Timestamptz(6)
  cancelledById    String?                      @map("cancelled_by_id") @db.Uuid
  cancelReason     ClassInvitationCancelReason? @map("cancel_reason")
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass SchoolClass               @relation(fields: [classId], references: [id], onDelete: Restrict)
  invitedBy   User                      @relation("ClassInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy  User?                     @relation("ClassInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  cancelledBy User?                     @relation("ClassInvitationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  deliveries  ClassInvitationDelivery[]
  enrollments Enrollment[]

  @@index([classId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([email])
  @@map("class_invitations")
}

/// One row per requested send (creation or resend). Never holds the token, the link or the body (D5).
model ClassInvitationDelivery {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId  String         @map("invitation_id") @db.Uuid
  status        DeliveryStatus
  attempts      Int            @default(0)
  nextAttemptAt DateTime?      @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCode String?        @map("last_error_code")
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitation ClassInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([invitationId, createdAt(sort: Desc)])
  @@map("class_invitation_deliveries")
}

model Enrollment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId       String           @map("class_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  status        EnrollmentStatus
  enrolledAt    DateTime         @map("enrolled_at") @db.Timestamptz(6)
  invitationId  String?          @map("invitation_id") @db.Uuid
  removedAt     DateTime?        @map("removed_at") @db.Timestamptz(6)
  removedById   String?          @map("removed_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass SchoolClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  student     StudentProfile   @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  invitation  ClassInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  removedBy   User?            @relation("EnrollmentRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([classId, status])
  @@index([studentUserId, status])
  @@map("enrollments")
}

// ── 004: subjects, syllabus documents and revisions, class calendar and plan ─────────────

model Subject {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId   String        @map("teacher_id") @db.Uuid
  /// Stored trimmed; unique per teacher ignoring case (SQL index on lower(name)).
  name        String
  description String?
  status      SubjectStatus @default(ACTIVE)
  /// Name, lowercase, without accents (003 D10); written by the application.
  searchKey   String        @map("search_key")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher           User               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classes           SchoolClass[]
  syllabusDocuments SyllabusDocument[]

  @@index([teacherId, status, name])
  @@map("subjects")
}

/// Original files, immutable (trigger rejects UPDATE and DELETE). Only PostgresFileStorage touches it (E4).
model StoredFile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bytes     Bytes    @db.ByteA
  /// CHECK size_bytes = octet_length(bytes).
  sizeBytes Int      @map("size_bytes")
  sha256    Bytes    @db.ByteA
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document SyllabusDocument?

  @@map("stored_files")
}

/// One uploaded syllabus version of a subject; also the processing queue (E7).
model SyllabusDocument {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId        String                    @map("subject_id") @db.Uuid
  version          Int
  fileId           String                    @unique @map("file_id") @db.Uuid
  originalFilename String                    @map("original_filename")
  mediaType        SyllabusMediaType         @map("media_type")
  sizeBytes        Int                       @map("size_bytes")
  sha256           Bytes                     @db.ByteA
  pageCount        Int?                      @map("page_count")
  processingStatus SyllabusProcessingStatus  @default(UPLOADED) @map("processing_status")
  attempts         Int                       @default(0)
  nextAttemptAt    DateTime                  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseExpiresAt   DateTime?                 @map("lease_expires_at") @db.Timestamptz(6)
  failureCategory  SyllabusFailureCategory?  @map("failure_category")
  extractionResult SyllabusExtractionResult? @map("extraction_result")
  /// SyllabusExtraction (E10); written once, in the PROCESSING → PROCESSED transition.
  extraction       Json?
  extractorVersion Int?                      @map("extractor_version")
  processedAt      DateTime?                 @map("processed_at") @db.Timestamptz(6)
  uploadedById     String                    @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject    Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  file       StoredFile         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy User               @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  revisions  SyllabusRevision[]

  /// Also serves the subject listing (newest version first) with a backward scan.
  @@unique([subjectId, version])
  /// The same file does not create a new version (FR-011).
  @@unique([subjectId, sha256])
  @@index([processingStatus, nextAttemptAt])
  @@map("syllabus_documents")
}

/// Reviewed content of a document. At most one DRAFT per document; CONFIRMED is immutable (triggers).
model SyllabusRevision {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId        String                 @map("document_id") @db.Uuid
  number            Int
  status            SyllabusRevisionStatus
  source            SyllabusRevisionSource
  /// Required iff source = REVISION (CHECK).
  basedOnRevisionId String?                @map("based_on_revision_id") @db.Uuid
  title             String?
  syllabusText      String?                @map("syllabus_text")
  competencyText    String?                @map("competency_text")
  /// Set together (CHECK).
  confirmedAt       DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  confirmedById     String?                @map("confirmed_by_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  document    SyllabusDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  basedOn     SyllabusRevision?  @relation("SyllabusRevisionBasedOn", fields: [basedOnRevisionId], references: [id], onDelete: Restrict)
  derived     SyllabusRevision[] @relation("SyllabusRevisionBasedOn")
  confirmedBy User?              @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  groups      SyllabusGroup[]
  items       SyllabusItem[]
  plans       ClassPlan[]

  @@unique([documentId, number])
  @@map("syllabus_revisions")
}

model SyllabusGroup {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId String  @map("revision_id") @db.Uuid
  position   Int
  title      String?

  revision SyllabusRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  items    SyllabusItem[]

  @@unique([revisionId, position])
  /// Target of the items' composite FK: an item's group belongs to the item's revision.
  @@unique([id, revisionId])
  @@map("syllabus_groups")
}

model SyllabusItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId   String  @map("revision_id") @db.Uuid
  groupId      String  @map("group_id") @db.Uuid
  position     Int
  text         String
  /// The item of the revision this one was copied from (source REVISION); lets a plan remap links (E16).
  originItemId String? @map("origin_item_id") @db.Uuid

  revision   SyllabusRevision    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  group      SyllabusGroup       @relation(fields: [groupId, revisionId], references: [id, revisionId], onDelete: Restrict)
  originItem SyllabusItem?       @relation("SyllabusItemOrigin", fields: [originItemId], references: [id], onDelete: Restrict)
  copies     SyllabusItem[]      @relation("SyllabusItemOrigin")
  topicLinks TopicSyllabusItem[]

  @@unique([groupId, position])
  @@index([revisionId])
  @@map("syllabus_items")
}

/// A class date. The meeting number is derived on read (row_number by date, E12).
model ClassMeeting {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String             @map("class_id") @db.Uuid
  meetingDate DateTime           @map("meeting_date") @db.Date
  status      ClassMeetingStatus @default(PLANNED)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  topics      Topic[]

  @@unique([classId, meetingDate])
  @@map("class_meetings")
}

/// One per class, created when the class first selects a confirmed syllabus revision.
model ClassPlan {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId            String          @unique @map("class_id") @db.Uuid
  syllabusRevisionId String          @map("syllabus_revision_id") @db.Uuid
  status             ClassPlanStatus @default(DRAFT)
  /// Optimistic concurrency counter (E13).
  revision           Int             @default(1)
  statusChangedAt    DateTime?       @map("status_changed_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass      SchoolClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  syllabusRevision SyllabusRevision @relation(fields: [syllabusRevisionId], references: [id], onDelete: Restrict)
  topics           Topic[]

  @@index([syllabusRevisionId])
  @@map("class_plans")
}

/// Never deleted. `archivedAt` is set iff status = ARCHIVED (CHECK).
model Topic {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId              String       @map("plan_id") @db.Uuid
  /// Restrict: a meeting with topics cannot be deleted (SC-008).
  meetingId           String?      @map("meeting_id") @db.Uuid
  title               String
  description         String?
  position            Int
  origin              TopicOrigin
  status              TopicStatus
  statusBeforeArchive TopicStatus? @map("status_before_archive")
  /// Date of the meeting when the topic was completed (004/US9); kept once archived.
  completedOn         DateTime?    @map("completed_on") @db.Date
  mergedIntoTopicId   String?      @map("merged_into_topic_id") @db.Uuid
  splitFromTopicId    String?      @map("split_from_topic_id") @db.Uuid
  archivedAt          DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdById         String       @map("created_by_id") @db.Uuid
  updatedById         String       @map("updated_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan       ClassPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  meeting    ClassMeeting?       @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  mergedInto Topic?              @relation("TopicMergedInto", fields: [mergedIntoTopicId], references: [id], onDelete: Restrict)
  mergedFrom Topic[]             @relation("TopicMergedInto")
  splitFrom  Topic?              @relation("TopicSplitFrom", fields: [splitFromTopicId], references: [id], onDelete: Restrict)
  splitInto  Topic[]             @relation("TopicSplitFrom")
  createdBy  User                @relation("TopicCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  User                @relation("TopicUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  items      TopicSyllabusItem[]

  /// DEFERRABLE INITIALLY DEFERRED in SQL, so reordering can swap positions in one transaction.
  @@unique([planId, position])
  @@index([planId, status, position])
  @@index([meetingId])
  @@map("topics")
}

model TopicSyllabusItem {
  topicId   String   @map("topic_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  topic Topic        @relation(fields: [topicId], references: [id], onDelete: Restrict)
  item  SyllabusItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([topicId, itemId])
  @@index([itemId])
  @@map("topic_syllabus_items")
}

model Invitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String
  displayName      String           @map("display_name")
  roleId           String           @map("role_id") @db.Uuid
  invitedById      String           @map("invited_by_id") @db.Uuid
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  sendCount        Int              @default(1) @map("send_count")
  lastSentAt       DateTime         @map("last_sent_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedById      String?          @map("revoked_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy  User  @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  revokedBy  User? @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([invitedById, status])
  @@index([email])
  @@map("invitations")
}

model UserToken {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  purpose       TokenPurpose
  tokenHash     String       @unique @map("token_hash")
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime?    @map("used_at") @db.Timestamptz(6)
  invalidatedAt DateTime?    @map("invalidated_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("user_tokens")
}

model AdminBootstrap {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  targetUserId String?         @map("target_user_id") @db.Uuid
  status       BootstrapStatus
  tokenHash    String?         @unique @map("token_hash")
  expiresAt    DateTime?       @map("expires_at") @db.Timestamptz(6)
  linkPrinted  Boolean         @default(false) @map("link_printed")
  operatorHost String          @map("operator_host")
  operatorUser String          @map("operator_user")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz(6)
  cancelledAt  DateTime?       @map("cancelled_at") @db.Timestamptz(6)

  targetUser User? @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@map("admin_bootstraps")
}

model Session {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  tokenHash         String               @unique @map("token_hash")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime             @map("last_used_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokeReason      SessionRevokeReason? @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model AuditEvent {
  id          BigInt    @id @default(autoincrement())
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  type        String
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  requestId   String?   @map("request_id")
  metadata    Json      @default("{}")

  @@index([type, occurredAt])
  @@index([targetType, targetId])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

model AccessRecord {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id") @db.Uuid
  ip         String   @db.Inet
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@map("access_records")
}

model RateLimitCounter {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// ---------------------------------------------------------------------------------------------
// Spec 006 — AI foundation (specs/006-ai-foundation/data-model.md). Definitions come from code
// and are synced at startup (research A4); used versions are immutable (triggers, A5). CHECKs,
// partial indexes, triggers and the ia.* permissions live in the `ai_foundation` migration.
// ---------------------------------------------------------------------------------------------

enum AiAgentStatus {
  DRAFT
  ACTIVE
  DISABLED
  DEPRECATED

  @@map("ai_agent_status")
}

/// L3_ACTION exists for the future and is refused by CHECK in this feature (006 FR-006).
enum AiRiskLevel {
  L1_READ_ONLY
  L2_PROPOSAL
  L3_ACTION

  @@map("ai_risk_level")
}

enum AiExecutionMode {
  ASYNC

  @@map("ai_execution_mode")
}

enum AiPromptStatus {
  DRAFT
  ACTIVE
  DEPRECATED

  @@map("ai_prompt_status")
}

enum AiModelConfigStatus {
  ENABLED
  DISABLED

  @@map("ai_model_config_status")
}

enum AiToolStatus {
  ENABLED
  DISABLED

  @@map("ai_tool_status")
}

enum AiExecutionStatus {
  QUEUED
  RUNNING
  WAITING_TOOL
  VALIDATING_OUTPUT
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT

  @@map("ai_execution_status")
}

/// Diagnostic step within RUNNING (research A8); the workflow is AiExecutionStatus.
enum AiExecutionStep {
  CONTEXT_RESOLVED
  MODEL_CALL
  TOOL_CALL
  OUTPUT_VALIDATION
  PROPOSAL_CREATED

  @@map("ai_execution_step")
}

/// DENIED only for tool calls.
enum AiCallStatus {
  SUCCEEDED
  DENIED
  FAILED
  TIMED_OUT

  @@map("ai_call_status")
}

enum AiProposalStatus {
  READY_FOR_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  EXPIRED

  @@map("ai_proposal_status")
}

enum AiEvaluationCaseStatus {
  ACTIVE
  RETIRED

  @@map("ai_evaluation_case_status")
}

/// Model configuration; never a credential (FR-018). Status is operational after the first sync.
model AiModelConfig {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String              @unique
  provider           String
  model              String
  status             AiModelConfigStatus
  parameters         Json                @default("{}")
  maxOutputTokens    Int                 @map("max_output_tokens")
  timeoutMs          Int                 @map("timeout_ms")
  inputPricePerMTok  Decimal?            @map("input_price_per_mtok") @db.Decimal(12, 6)
  outputPricePerMTok Decimal?            @map("output_price_per_mtok") @db.Decimal(12, 6)
  currency           String?             @db.Char(3)
  definitionHash     String              @map("definition_hash")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  agentVersions     AiAgentVersion[]
  executions        AiExecution[]
  modelCalls        AiModelCall[]
  evaluationResults AiEvaluationResult[]

  @@map("ai_model_configs")
}

/// Stable identity of an agent; its behavior lives in the versions.
model AiAgent {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String        @unique
  name             String
  description      String
  status           AiAgentStatus
  currentVersionId String?       @map("current_version_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentVersion  AiAgentVersion?         @relation("AiAgentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions        AiAgentVersion[]        @relation("AiAgentVersions")
  prompts         AiPromptVersion[]
  outputSchemas   AiOutputSchemaVersion[]
  evaluationCases AiEvaluationCase[]

  @@map("ai_agents")
}

/// Snapshot of an agent definition; content immutable once `used_at` is set (trigger).
model AiAgentVersion {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId               String          @map("agent_id") @db.Uuid
  version               Int
  riskLevel             AiRiskLevel     @map("risk_level")
  executionMode         AiExecutionMode @default(ASYNC) @map("execution_mode")
  requiredPermission    String          @map("required_permission")
  promptVersionId       String          @map("prompt_version_id") @db.Uuid
  outputSchemaVersionId String?         @map("output_schema_version_id") @db.Uuid
  modelConfigId         String          @map("model_config_id") @db.Uuid
  resourceTypes         String[]        @map("resource_types")
  proposalType          String?         @map("proposal_type")
  limits                Json            @default("{}")
  onToolDenied          String          @default("fail") @map("on_tool_denied")
  definitionHash        String          @map("definition_hash")
  usedAt                DateTime?       @map("used_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  agent             AiAgent                @relation("AiAgentVersions", fields: [agentId], references: [id], onDelete: Restrict)
  permission        Permission             @relation(fields: [requiredPermission], references: [key], onDelete: Restrict)
  promptVersion     AiPromptVersion        @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  outputSchema      AiOutputSchemaVersion? @relation(fields: [outputSchemaVersionId], references: [id], onDelete: Restrict)
  modelConfig       AiModelConfig          @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)
  currentOf         AiAgent[]              @relation("AiAgentCurrentVersion")
  tools             AiAgentTool[]
  executions        AiExecution[]
  proposals         AiProposal[]
  evaluationResults AiEvaluationResult[]

  @@unique([agentId, version])
  @@map("ai_agent_versions")
}

/// System instructions from code; never returned by an endpoint nor logged.
model AiPromptVersion {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId            String         @map("agent_id") @db.Uuid
  key                String
  version            Int
  systemInstructions String         @map("system_instructions")
  contentHash        String         @map("content_hash")
  status             AiPromptStatus
  usedAt             DateTime?      @map("used_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  agent             AiAgent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentVersions     AiAgentVersion[]
  executions        AiExecution[]
  evaluationResults AiEvaluationResult[]

  @@unique([agentId, key, version])
  @@map("ai_prompt_versions")
}

model AiOutputSchemaVersion {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId    String    @map("agent_id") @db.Uuid
  version    Int
  jsonSchema Json      @map("json_schema")
  schemaHash String    @map("schema_hash")
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agent         AiAgent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentVersions AiAgentVersion[]
  executions    AiExecution[]
  outputs       AiExecutionOutput[]

  @@unique([agentId, version])
  @@map("ai_output_schema_versions")
}

model AiTool {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String       @unique
  name               String
  description        String
  riskLevel          AiRiskLevel  @map("risk_level")
  timeoutMs          Int          @map("timeout_ms")
  status             AiToolStatus
  requiredPermission String       @map("required_permission")
  resourceType       String?      @map("resource_type")
  inputJsonSchema    Json         @map("input_json_schema")
  outputFields       String[]     @map("output_fields")
  definitionHash     String       @map("definition_hash")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  permission Permission    @relation(fields: [requiredPermission], references: [key], onDelete: Restrict)
  agents     AiAgentTool[]
  calls      AiToolCall[]

  @@map("ai_tools")
}

/// Explicit tool allowlist of an agent version (FR-034); no wildcard.
model AiAgentTool {
  agentVersionId String @map("agent_version_id") @db.Uuid
  toolId         String @map("tool_id") @db.Uuid

  agentVersion AiAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  tool         AiTool         @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@id([agentVersionId, toolId])
  @@map("ai_agent_tools")
}

/// One agent execution; the table is also the worker's queue (research A6).
model AiExecution {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The session teacher (research A2).
  workspaceId           String            @map("workspace_id") @db.Uuid
  requestedByUserId     String            @map("requested_by_user_id") @db.Uuid
  agentVersionId        String            @map("agent_version_id") @db.Uuid
  agentKey              String            @map("agent_key")
  agentVersion          Int               @map("agent_version")
  promptVersionId       String            @map("prompt_version_id") @db.Uuid
  promptVersion         Int               @map("prompt_version")
  outputSchemaVersionId String?           @map("output_schema_version_id") @db.Uuid
  modelConfigId         String            @map("model_config_id") @db.Uuid
  provider              String
  model                 String
  riskLevel             AiRiskLevel       @map("risk_level")
  resourceType          String?           @map("resource_type")
  resourceId            String?           @map("resource_id") @db.Uuid
  /// Request input; pedagogical, owner-only, never logged.
  input                 Json              @default("{}")
  status                AiExecutionStatus @default(QUEUED)
  step                  AiExecutionStep?
  errorCode             String?           @map("error_code")
  modelCalls            Int               @default(0) @map("model_calls")
  toolCalls             Int               @default(0) @map("tool_calls")
  /// Times the worker took the execution; model call retries are in ai_model_calls.attempts.
  claims                Int               @default(0)
  claimToken            String?           @map("claim_token") @db.Uuid
  leaseExpiresAt        DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  deadlineAt            DateTime          @map("deadline_at") @db.Timestamptz(6)
  cancelRequestedAt     DateTime?         @map("cancel_requested_at") @db.Timestamptz(6)
  correlationId         String            @map("correlation_id")
  idempotencyKey        String            @map("idempotency_key") @db.Uuid
  requestHash           String            @map("request_hash")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt             DateTime?         @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime?         @map("finished_at") @db.Timestamptz(6)
  durationMs            Int?              @map("duration_ms")

  workspace        User                    @relation("AiExecutionWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  requestedBy      User                    @relation("AiExecutionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  agentVersionRef  AiAgentVersion          @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  promptVersionRef AiPromptVersion         @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  outputSchema     AiOutputSchemaVersion?  @relation(fields: [outputSchemaVersionId], references: [id], onDelete: Restrict)
  modelConfig      AiModelConfig           @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)
  transitions      AiExecutionTransition[]
  output           AiExecutionOutput?
  modelCallRows    AiModelCall[]
  toolCallRows     AiToolCall[]
  proposal         AiProposal?

  @@unique([requestedByUserId, idempotencyKey])
  @@index([workspaceId, createdAt(sort: Desc), id])
  @@index([agentVersionId, createdAt])
  @@index([createdAt])
  @@map("ai_executions")
}

/// Append-only trail of status changes (US1-2).
model AiExecutionTransition {
  id          BigInt             @id @default(autoincrement())
  executionId String             @map("execution_id") @db.Uuid
  fromStatus  AiExecutionStatus? @map("from_status")
  toStatus    AiExecutionStatus  @map("to_status")
  occurredAt  DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, id])
  @@map("ai_execution_transitions")
}

/// Validated result of an L1 agent; owner-only.
model AiExecutionOutput {
  executionId           String   @id @map("execution_id") @db.Uuid
  outputSchemaVersionId String   @map("output_schema_version_id") @db.Uuid
  output                Json
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  execution    AiExecution           @relation(fields: [executionId], references: [id], onDelete: Cascade)
  outputSchema AiOutputSchemaVersion @relation(fields: [outputSchemaVersionId], references: [id], onDelete: Restrict)

  @@map("ai_execution_outputs")
}

/// One call to the model: the "Uso de IA" of the spec (research A16).
model AiModelCall {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId   String       @map("execution_id") @db.Uuid
  sequence      Int
  modelConfigId String       @map("model_config_id") @db.Uuid
  provider      String
  model         String
  status        AiCallStatus
  attempts      Int
  errorCode     String?      @map("error_code")
  startedAt     DateTime     @map("started_at") @db.Timestamptz(6)
  durationMs    Int          @map("duration_ms")
  inputTokens   Int?         @map("input_tokens")
  outputTokens  Int?         @map("output_tokens")
  totalTokens   Int?         @map("total_tokens")
  estimatedCost Decimal?     @map("estimated_cost") @db.Decimal(14, 6)
  currency      String?      @db.Char(3)

  execution   AiExecution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  modelConfig AiModelConfig @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)

  @@unique([executionId, sequence])
  @@index([startedAt])
  @@map("ai_model_calls")
}

/// One tool call; never its arguments or result (FR-037).
model AiToolCall {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String       @map("execution_id") @db.Uuid
  sequence    Int
  /// The key the model asked for, even if unknown.
  toolKey     String       @map("tool_key")
  toolId      String?      @map("tool_id") @db.Uuid
  status      AiCallStatus
  errorCode   String?      @map("error_code")
  startedAt   DateTime     @map("started_at") @db.Timestamptz(6)
  completedAt DateTime     @map("completed_at") @db.Timestamptz(6)
  durationMs  Int          @map("duration_ms")

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  tool      AiTool?     @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@unique([executionId, sequence])
  @@map("ai_tool_calls")
}

/// Proposal of an L2 agent for the teacher's review; `payload` is immutable (trigger, FR-047).
model AiProposal {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  executionId        String           @unique @map("execution_id") @db.Uuid
  agentVersionId     String           @map("agent_version_id") @db.Uuid
  agentKey           String           @map("agent_key")
  proposalType       String           @map("proposal_type")
  targetResourceType String           @map("target_resource_type")
  targetResourceId   String?          @map("target_resource_id") @db.Uuid
  payload            Json
  itemIds            String[]         @map("item_ids")
  acceptedItemIds    String[]         @default([]) @map("accepted_item_ids")
  status             AiProposalStatus @default(READY_FOR_REVIEW)
  expiresAt          DateTime         @map("expires_at") @db.Timestamptz(6)
  decidedAt          DateTime?        @map("decided_at") @db.Timestamptz(6)
  decidedByUserId    String?          @map("decided_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    User           @relation("AiProposalWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  execution    AiExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  agentVersion AiAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  decidedBy    User?          @relation("AiProposalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, createdAt(sort: Desc), id])
  @@map("ai_proposals")
}

model AiEvaluationCase {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId   String                 @map("agent_id") @db.Uuid
  key       String
  version   Int
  /// A fixture path or an id, never content copied from a teacher.
  inputRef  String                 @map("input_ref")
  expected  Json
  status    AiEvaluationCaseStatus
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  agent   AiAgent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  results AiEvaluationResult[]

  @@unique([agentId, key, version])
  @@map("ai_evaluation_cases")
}

model AiEvaluationResult {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  agentVersionId  String   @map("agent_version_id") @db.Uuid
  promptVersionId String   @map("prompt_version_id") @db.Uuid
  modelConfigId   String   @map("model_config_id") @db.Uuid
  provider        String
  model           String
  passed          Boolean
  /// Numbers only.
  metrics         Json     @default("{}")
  ranAt           DateTime @default(now()) @map("ran_at") @db.Timestamptz(6)

  evaluationCase AiEvaluationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  agentVersion   AiAgentVersion   @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  promptVersion  AiPromptVersion  @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  modelConfig    AiModelConfig    @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)

  @@map("ai_evaluation_results")
}
