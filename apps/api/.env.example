# DevTrack API configuration. Copy to .env and fill in. Never commit real values.
# The API refuses to start if a required variable is missing or invalid (FR-074).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (docker compose service "postgres").
DATABASE_URL=postgresql://devtrack:devtrack@localhost:5432/devtrack

# Secret used to derive rate-limit keys (HMAC-SHA-256). At least 32 random bytes,
# base64-encoded. Generate with: openssl rand -base64 48
APP_HMAC_SECRET=

# Public origin of the web app; used to build links sent by e-mail.
WEB_ORIGIN=http://localhost:3000
# Comma-separated origins accepted on unsafe methods (CSRF protection, R6).
ALLOWED_ORIGINS=http://localhost:3000

# Outgoing mail. In development, Mailpit captures everything (UI at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM="DevTrack <no-reply@devtrack.local>"

# Number of reverse proxies in front of the API whose X-Forwarded-For entries are
# trusted to determine the client IP. Next.js rewrite in dev = 1. A wrong value lets
# clients spoof their IP and weakens rate limiting and access records (FR-022, FR-076).
TRUST_PROXY_HOPS=1

# Optional rate limits (defaults shown; window in seconds).
# RATE_LIMIT_LOGIN_EMAIL_ORIGIN_FAILURES=5
# RATE_LIMIT_LOGIN_ORIGIN_FAILURES=100
# RATE_LIMIT_PUBLIC_ORIGIN=300
# RATE_LIMIT_PUBLIC_TARGET=5
# RATE_LIMIT_WINDOW_SECONDS=900
# Class invitations (FR-021): seconds between resends of one invitation, sends per invitation
# per 24 h (creation + manual resends; automatic retries don't count), sends per teacher per hour.
# RATE_LIMIT_CLASS_INVITE_RESEND_SECONDS=60
# RATE_LIMIT_CLASS_INVITE_DAILY_SENDS=5
# RATE_LIMIT_CLASS_INVITE_TEACHER_HOURLY=50
# Syllabus documents (E20): uploads and "Tentar novamente" per teacher per hour.
# RATE_LIMIT_SYLLABUS_UPLOADS_HOURLY=20
# RATE_LIMIT_SYLLABUS_RETRIES_HOURLY=10
# AI (006 research A17): execution requests and proposal decisions per user per minute.
# RATE_LIMIT_AI_EXECUTIONS_PER_MINUTE=10
# RATE_LIMIT_AI_DECISIONS_PER_MINUTE=30
# Curriculum Agent (007 research C13): "Preencher com IA" requests per teacher per hour.
# RATE_LIMIT_CURRICULUM_AI_PER_HOUR=10

# Retention/maintenance interval in seconds (R21). 0 disables the in-process scheduler.
# MAINTENANCE_INTERVAL_SECONDS=3600

# Interval in seconds of the class invitation delivery retry worker (FR-019). 0 disables it.
# MAIL_RETRY_INTERVAL_SECONDS=30

# Syllabus documents (E20): upload size limit in MB, interval in seconds of the processing
# worker (0 disables processing, including the start right after an upload; uploads stay
# UPLOADED) and timeout in seconds of each extraction attempt.
# SYLLABUS_MAX_FILE_MB=10
# SYLLABUS_PROCESSING_INTERVAL_SECONDS=10
# SYLLABUS_PROCESSING_TIMEOUT_SECONDS=120

# AI foundation (006 research A17). Interval in seconds of the AI execution worker (0 disables it, including the start
# right after a request — the global kill switch); per-execution limits; proposal validity and
# retention of finished executions, in days.
# AI_EXECUTION_INTERVAL_SECONDS=5
# AI_EXECUTION_TOTAL_TIMEOUT_SECONDS=120
# AI_MODEL_CALL_TIMEOUT_SECONDS=60
# AI_TOOL_TIMEOUT_SECONDS=10
# AI_MAX_MODEL_CALLS=5
# AI_MAX_TOOL_CALLS=10
# AI_MAX_RETRIES=2
# AI_MAX_INPUT_KB=200
# AI_MAX_OUTPUT_KB=200
# AI_PROPOSAL_TTL_DAYS=30
# AI_RECORD_RETENTION_DAYS=365

# Anthropic provider (007 research C2), the only real AI provider. Empty = AI off: the provider
# is not registered, "Preencher com IA" shows "indisponível no momento" and the manual flow keeps
# working; the API still starts. The key is never logged. ANTHROPIC_BASE_URL is only for the
# local E2E run, which points it at a mock of the Messages API; leave it unset otherwise.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
