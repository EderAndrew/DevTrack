{
  "name": "devtrack",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev code-runner:dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "admin:bootstrap": "pnpm --filter api admin:bootstrap --"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "^2.11.11",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24"
  }
}
